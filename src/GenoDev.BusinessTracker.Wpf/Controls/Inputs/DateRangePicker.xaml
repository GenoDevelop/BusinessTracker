<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Controls.DateRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="DateRangeToggle"
                      HorizontalContentAlignment="Stretch"
                      Background="{DynamicResource SurfaceBrush}">
            <ToggleButton.Style>
                <Style TargetType="{x:Type ToggleButton}"
                       BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="MinHeight" Value="28" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                            <Setter Property="Padding" Value="3,1" />
                            <Setter Property="MinHeight" Value="24" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StartDate, ElementName=Root, StringFormat='dd.MM.yyyy'}" />
                    <TextBlock Text=" - " Visibility="{Binding EndDate, ElementName=Root, Converter={StaticResource NullToAllConverter}, ConverterParameter='Visible;Collapsed'}" />
                    <TextBlock Text="{Binding EndDate, ElementName=Root, StringFormat='dd.MM.yyyy'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Visibility="{Binding StartDate, ElementName=Root, Converter={StaticResource NullToAllConverter}, ConverterParameter='Visible;Collapsed'}"
                            Click="ClearButton_Click" 
                            Margin="0,0,3,0"
                            Padding="5"
                            MinWidth="22"
                            MinHeight="22"
                            Background="Transparent" BorderThickness="0" 
                            VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="Wyczyść zakres">
                        <Path Data="{StaticResource CloseIconGeometry}"
                              Style="{StaticResource ToolbarIconStyle}"
                              Width="12"
                              Height="12" />
                    </Button>
                    <Path Data="{StaticResource CalendarIconGeometry}"
                          Style="{StaticResource ToolbarIconStyle}"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          Width="16"
                          Height="16"
                          VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ToggleButton>
        <Popup IsOpen="{Binding IsChecked, ElementName=DateRangeToggle}"
               PlacementTarget="{Binding ElementName=DateRangeToggle}"
               StaysOpen="False"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Fade">
            <Border Margin="0,6,10,12"
                    Padding="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Effect>
                    <StaticResource ResourceKey="PopupShadow" />
                </Border.Effect>
                <Calendar SelectionMode="SingleRange"
                          x:Name="RangeCalendar"
                          Style="{StaticResource ModernCalendarStyle}"
                          BorderThickness="0"
                          SelectedDatesChanged="RangeCalendar_SelectedDatesChanged" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
