<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Controls.EnumMultiSelectComboBox"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--
        The custom template is necessary because the standard ComboBox
        selection box can display only one selected item.
        -->
        <Style x:Key="EnumMultiSelectComboBoxStyle"
               TargetType="{x:Type ComboBox}">
            <Setter Property="MinWidth"
                    Value="110" />
            <Setter Property="Height"
                    Value="22" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#808080" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="MaxDropDownHeight"
                    Value="250" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Padding="0"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{TemplateBinding Tag}"
                                               Margin="6,0,4,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="Normal" />

                                    <Path Grid.Column="1"
                                          Width="8"
                                          Height="4"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   PopupAnimation="Fade">

                                <Border MinWidth="{Binding ActualWidth,
                                                          ElementName=DropDownToggle}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="1"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="DropDownToggle"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox x:Name="SelectionComboBox"
                  Grid.Column="0"
                  Tag="{Binding SelectionDisplayText, ElementName=Root}"
                  ItemsSource="{Binding Options, ElementName=Root}"
                  IsEnabled="{Binding HasOptions, ElementName=Root}"
                  IsTextSearchEnabled="False"
                  Style="{StaticResource EnumMultiSelectComboBoxStyle}">

            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="Padding"
                            Value="5,3" />

                    <EventSetter Event="PreviewMouseLeftButtonDown"
                                 Handler="OptionItem_PreviewMouseLeftButtonDown" />

                    <EventSetter Event="PreviewMouseLeftButtonUp"
                                 Handler="OptionItem_PreviewMouseLeftButtonUp" />

                    <EventSetter Event="PreviewKeyDown"
                                 Handler="OptionItem_PreviewKeyDown" />
                </Style>
            </ComboBox.ItemContainerStyle>

            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <!--
                    Mouse handling is performed by the ComboBoxItem.
                    This prevents the standard ComboBox from closing
                    and changing SelectedItem automatically.
                    -->
                    <CheckBox Content="{Binding Display}"
                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                              IsHitTestVisible="False"
                              Focusable="False"
                              VerticalAlignment="Center"
                              FontWeight="Normal" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="1"
                Width="22"
                Height="22"
                Margin="2,0,0,0"
                Padding="0"
                Content="×"
                ToolTip="Clear selection"
                Click="ClearSelection_Click">

            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Visibility"
                            Value="Collapsed" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection,
                                                      ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
