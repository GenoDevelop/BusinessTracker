<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Controls.MailAttachmentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             x:Name="Root" Width="166" Height="76">
    <UserControl.Resources>
        <Style x:Key="AttachmentActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.78"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AttachmentActionHoverBrush}"/></Trigger>
                <DataTrigger Binding="{Binding IsWarning, RelativeSource={RelativeSource AncestorType={x:Type controls:MailAttachmentCard}}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AttachmentWarningForegroundBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsWarning, RelativeSource={RelativeSource AncestorType={x:Type controls:MailAttachmentCard}}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource WarningHoverBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.ToolTip>
        <ToolTip DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
        <StackPanel MaxWidth="360">
            <TextBlock Text="{Binding DataContext.FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Description}" Margin="0,3,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        </ToolTip>
    </UserControl.ToolTip>
    <Border BorderThickness="1" CornerRadius="5" ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWarning, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsWarning, ElementName=Root}" Value="True"><Setter Property="Background" Value="{DynamicResource AttachmentWarningSurfaceBrush}"/></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Path Data="M15,5 H39 L51,17 V59 H15 Z M39,5 V17 H51" Stretch="Uniform"
                          Width="34" Height="46" StrokeThickness="1.5" Opacity="0.8">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsWarning, ElementName=Root}" Value="True"><Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Border CornerRadius="2" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsWarning, ElementName=Root}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FileTypeLabel}" Foreground="{DynamicResource OnAccentBrush}" FontSize="8" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,9,7,7" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DisplaySize}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            <Border x:Name="HoverOverlay" Grid.ColumnSpan="2" Opacity="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AttachmentHoverOverlayBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsWarning, ElementName=Root}" Value="True"><Setter Property="Background" Value="{DynamicResource AttachmentWarningHoverOverlayBrush}"/></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,5,5">
                    <Button Command="{Binding DownloadCommand, ElementName=Root}" CommandParameter="{Binding}"
                            Margin="0,0,4,0" ToolTip="Zapisz na komputerze">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AttachmentActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsDownloadAvailable, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Viewbox><Canvas Width="18" Height="18"><Path Data="M9,2 V11 M5.5,7.5 L9,11 L12.5,7.5 M3,14 V16 H15 V14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                    </Button>
                    <Button Command="{Binding AcceptCommand, ElementName=Root}" CommandParameter="{Binding}"
                            Margin="0,0,4,0" ToolTip="Zaakceptuj aktualny plik">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AttachmentActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsAcceptAvailable, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Viewbox><Canvas Width="18" Height="18"><Path Data="M3,9 L7,13 L15,4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                    </Button>
                    <Button Command="{Binding ReplaceCommand, ElementName=Root}" CommandParameter="{Binding}"
                            Margin="0,0,4,0" ToolTip="Podmień plik">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AttachmentActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsReplaceAvailable, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Viewbox><Canvas Width="18" Height="18"><Path Data="M3,6 H13 M10,3 L13,6 L10,9 M15,12 H5 M8,9 L5,12 L8,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                    </Button>
                    <Button Command="{Binding RemoveCommand, ElementName=Root}" CommandParameter="{Binding}"
                            ToolTip="Usuń załącznik" Style="{StaticResource AttachmentActionButtonStyle}">
                        <Viewbox><Canvas Width="18" Height="18"><Path Data="M4,5 H14 M7,5 V3 H11 V5 M6,7 V15 H12 V7 M8,8 V13 M10,8 V13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></EventTrigger>
    </UserControl.Triggers>
</UserControl>
