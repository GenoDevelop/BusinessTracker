<Window x:Class="GenoDev.BusinessTracker.Wpf.Controls.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        SizeToContent="WidthAndHeight"
        MinWidth="300" MinHeight="136"
        Padding="24"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="WindowBorder"
                Background="{DynamicResource GlassSurfaceBrush}"
                SnapsToDevicePixels="True"
                RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="OpeningScaleTransform" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Padding="22,0"
                    Background="{DynamicResource GlassSheenBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="4" Height="22" Background="{DynamicResource AccentBrush}"
                            CornerRadius="2" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="12,-2,0,0"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <controls:PeekThroughButton Grid.Column="2"
                                                Margin="8,0,0,0"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                PreviewMouseLeftButtonDown="PeekThroughButton_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="PeekThroughButton_PreviewMouseLeftButtonUp"
                                                LostMouseCapture="PeekThroughButton_LostMouseCapture" />
                    <controls:TopmostButton x:Name="TopmostButton"
                                            Grid.Column="3"
                                            Margin="8,0,0,0"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Checked="TopmostButton_CheckedChanged"
                                            Unchecked="TopmostButton_CheckedChanged" />
                    <Button Grid.Column="4" Style="{StaticResource IconButton}"
                            Margin="8,0,0,0" Padding="0" ToolTip="Ukryj okno"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path Data="M3,15 L17,15"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeButton" Grid.Column="5" Style="{StaticResource IconButton}"
                            Margin="8,0,0,0" Padding="0" ToolTip="Pełny ekran"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path x:Name="MaximizeIcon" Data="M2,2 L18,2 L18,18 L2,18 Z"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Margin="8,0,0,0" Padding="0"
                            ToolTip="Zamknij"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path Data="M3,3 L17,17 M17,3 L3,17"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
            <ContentPresenter Grid.Row="2"
                              Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type controls:PopupWindow}}}"
                              Content="{Binding WindowContent, RelativeSource={RelativeSource AncestorType={x:Type controls:PopupWindow}}}"
                              HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type controls:PopupWindow}}}"
                              VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type controls:PopupWindow}}}"
                              SnapsToDevicePixels="True" />

        </Grid>
        </Border>

    </Grid>
</Window>
