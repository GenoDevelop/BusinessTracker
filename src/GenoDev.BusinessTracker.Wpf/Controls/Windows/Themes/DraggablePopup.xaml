<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls">

    <Style TargetType="{x:Type controls:DraggablePopup}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Foreground" Value="#202020" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DraggablePopup}">
                    <Popup x:Name="PART_Popup"
                           Placement="AbsolutePoint"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Focusable="True">

                        <Border Margin="12"
                                Background="White"
                                BorderBrush="#AFAFAF"
                                BorderThickness="1"
                                CornerRadius="6"
                                DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                                KeyboardNavigation.TabNavigation="Cycle"
                                SnapsToDevicePixels="True">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.35" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="PART_DragArea"
                                        Grid.Row="0"
                                        Padding="16,0"
                                        Background="Transparent"
                                        Cursor="SizeAll">
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <Border Grid.Row="1"
                                        Background="#E8E8E8" />

                                <ContentPresenter Grid.Row="2"
                                                  Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                    </Popup>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragEnabled" Value="False">
                            <Setter TargetName="PART_DragArea"
                                    Property="Cursor"
                                    Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
