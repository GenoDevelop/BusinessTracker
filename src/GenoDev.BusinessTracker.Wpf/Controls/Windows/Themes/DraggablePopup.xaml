<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls">

    <Style TargetType="{x:Type controls:DraggablePopup}">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DraggablePopup}">
                    <Popup x:Name="PART_Popup"
                           Placement="AbsolutePoint"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Focusable="True">

                        <Border Margin="22"
                                Background="{DynamicResource GlassSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                                KeyboardNavigation.TabNavigation="Cycle"
                                SnapsToDevicePixels="True">

                            <Border.Effect>
                                <StaticResource ResourceKey="PopupShadow" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="PART_DragArea"
                                        Grid.Row="0"
                                        Padding="22,0"
                                        Background="{DynamicResource GlassSheenBrush}"
                                        CornerRadius="16,16,0,0"
                                        Cursor="SizeAll">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4"
                                                Height="22"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Text="{TemplateBinding Title}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource BorderBrush}" />

                                <ContentPresenter Grid.Row="2"
                                                  Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                    </Popup>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragEnabled" Value="False">
                            <Setter TargetName="PART_DragArea"
                                    Property="Cursor"
                                    Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
