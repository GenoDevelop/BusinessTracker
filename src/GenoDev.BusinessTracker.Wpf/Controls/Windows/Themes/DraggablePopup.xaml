<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls">

    <Style TargetType="{x:Type controls:DraggablePopup}">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DraggablePopup}">
                    <Popup x:Name="PART_Popup"
                           Placement="AbsolutePoint"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Focusable="True">

                        <Border x:Name="PopupBorder"
                                Width="{Binding PopupWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Height="{Binding PopupHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                MinWidth="{Binding MinPopupWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MinHeight="{Binding MinPopupHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxWidth="{Binding MaxPopupWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{Binding MaxPopupHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="22"
                                Background="{DynamicResource GlassSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                                KeyboardNavigation.TabNavigation="Cycle"
                                SnapsToDevicePixels="True">

                            <Border.Effect>
                                <StaticResource ResourceKey="PopupShadow" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="PART_DragArea"
                                        Grid.Row="0"
                                        Padding="22,0"
                                        Background="{DynamicResource GlassSheenBrush}"
                                        CornerRadius="16,16,0,0"
                                        Cursor="SizeAll">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4"
                                                Height="22"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Text="{TemplateBinding Title}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button x:Name="MaximizeButton"
                                                Grid.Column="2"
                                                Command="{Binding ToggleMaximizeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource IconButton}"
                                                Margin="8,0,0,0">
                                            <Viewbox Width="16" Height="16">
                                                <Path x:Name="MaximizeIcon"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round" />
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource BorderBrush}" />

                                <ContentPresenter Grid.Row="2"
                                                  Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                                <primitives:Thumb x:Name="PART_ResizeThumb"
                                                  Grid.RowSpan="3"
                                                  Width="22"
                                                  Height="22"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Bottom"
                                                  Cursor="SizeNWSE"
                                                  Background="Transparent"
                                                  Margin="0,0,2,2">
                                    <primitives:Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                            <Grid Background="Transparent">
                                                <Path Data="M7,17 L17,7 M12,17 L17,12"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Grid>
                                        </ControlTemplate>
                                    </primitives:Thumb.Template>
                                </primitives:Thumb>
                            </Grid>
                        </Border>
                    </Popup>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragEnabled" Value="False">
                            <Setter TargetName="PART_DragArea"
                                    Property="Cursor"
                                    Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsResizable" Value="False">
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_ResizeThumb" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMaximized" Value="False">
                            <Setter TargetName="MaximizeButton" Property="ToolTip" Value="Pełny ekran" />
                            <Setter TargetName="MaximizeIcon" Property="Data" Value="M4,4 L20,4 L20,20 L4,20 Z" />
                        </Trigger>
                        <Trigger Property="IsMaximized" Value="True">
                            <Setter TargetName="PopupBorder" Property="Margin" Value="0" />
                            <Setter TargetName="PopupBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="PART_DragArea" Property="CornerRadius" Value="0" />
                            <Setter TargetName="PART_DragArea" Property="Cursor" Value="Arrow" />
                            <Setter TargetName="PART_ResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MaximizeButton" Property="ToolTip" Value="Przywróć rozmiar" />
                            <Setter TargetName="MaximizeIcon" Property="Data" Value="M7,4 L20,4 L20,17 M4,7 L17,7 L17,20 L4,20 Z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
