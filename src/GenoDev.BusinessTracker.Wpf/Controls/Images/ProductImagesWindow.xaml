<Window x:Class="GenoDev.BusinessTracker.Wpf.Controls.ProductImagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Zdjęcia produktu"
        Width="904" Height="724"
        MinWidth="564" MinHeight="464"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <Style x:Key="ManualWindowResizeThumbStyle" TargetType="{x:Type primitives:Thumb}">
            <!-- Layered HWNDs ignore fully transparent pixels during native hit testing. -->
            <Setter Property="Background" Value="#01FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="WindowBorder" Margin="22"
                Background="{DynamicResource GlassSurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="16" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Padding="22,0"
                    Background="{DynamicResource GlassSheenBrush}" CornerRadius="16,16,0,0"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                    LostMouseCapture="TitleBar_LostMouseCapture">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="4" Height="22" Background="{DynamicResource AccentBrush}"
                            CornerRadius="2" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <controls:PeekThroughButton Grid.Column="2"
                                                Margin="8,0,0,0"
                                                PreviewMouseLeftButtonDown="PeekThroughButton_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="PeekThroughButton_PreviewMouseLeftButtonUp"
                                                LostMouseCapture="PeekThroughButton_LostMouseCapture" />
                    <controls:TopmostButton x:Name="TopmostButton"
                                            Grid.Column="3"
                                            Margin="8,0,0,0"
                                            Checked="TopmostButton_CheckedChanged"
                                            Unchecked="TopmostButton_CheckedChanged" />
                    <Button x:Name="MaximizeButton" Grid.Column="4" Style="{StaticResource IconButton}"
                            Margin="8,0,0,0" Padding="0" ToolTip="Pełny ekran"
                            Click="MaximizeButton_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path x:Name="MaximizeIcon" Data="M2,2 L18,2 L18,18 L2,18 Z"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Margin="8,0,0,0" Padding="0"
                            ToolTip="Zamknij"
                            Click="CloseButton_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="20" Height="20">
                                <Path Data="M3,3 L17,17 M17,3 L3,17"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
            <Grid Grid.Row="2" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:ProductImagesPanel IsFullGallery="True" />
                <Button Grid.Row="1" Content="Zamknij" Command="{Binding ClosePopupCommand}"
                        HorizontalAlignment="Right" Margin="0,10,0,0" Padding="15,5" />
                <controls:DraggablePopup Grid.RowSpan="2" IsOpen="{Binding IsDeleteConfirmationOpen}"
                                         Title="Potwierdź usunięcie zdjęcia" StaysOpen="True">
                    <StackPanel Width="320">
                        <TextBlock Text="Czy na pewno chcesz usunąć wybrane zdjęcie produktu?"
                                   TextWrapping="Wrap" Margin="0,0,0,20" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Anuluj" Command="{Binding CancelDeleteCommand}"
                                    Margin="0,0,10,0" Padding="15,5" />
                            <Button Content="Usuń" Command="{Binding ConfirmDeleteCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Padding="15,5" IsDefault="True" />
                        </StackPanel>
                    </StackPanel>
                </controls:DraggablePopup>
            </Grid>

        </Grid>
        </Border>

        <Grid x:Name="ResizeLayer" Margin="18" Panel.ZIndex="100">
            <primitives:Thumb Tag="Left" Width="8" HorizontalAlignment="Left"
                              Cursor="SizeWE" Style="{StaticResource ManualWindowResizeThumbStyle}"
                              DragDelta="ResizeThumb_DragDelta" />
            <primitives:Thumb Tag="Right" Width="8" HorizontalAlignment="Right"
                              Cursor="SizeWE" Style="{StaticResource ManualWindowResizeThumbStyle}"
                              DragDelta="ResizeThumb_DragDelta" />
            <primitives:Thumb Tag="Top" Height="8" VerticalAlignment="Top"
                              Cursor="SizeNS" Style="{StaticResource ManualWindowResizeThumbStyle}"
                              DragDelta="ResizeThumb_DragDelta" />
            <primitives:Thumb Tag="Bottom" Height="8" VerticalAlignment="Bottom"
                              Cursor="SizeNS" Style="{StaticResource ManualWindowResizeThumbStyle}"
                              DragDelta="ResizeThumb_DragDelta" />

            <primitives:Thumb Tag="TopLeft" Width="8" Height="8"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Cursor="SizeNWSE" Style="{StaticResource ManualWindowResizeThumbStyle}"
                              DragDelta="ResizeThumb_DragDelta" />
            <primitives:Thumb Tag="TopRight" Width="8" Height="8"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Cursor="SizeNESW" Style="{StaticResource ManualWindowResizeThumbStyle}"
                              DragDelta="ResizeThumb_DragDelta" />
            <primitives:Thumb Tag="BottomLeft" Width="8" Height="8"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Cursor="SizeNESW" Style="{StaticResource ManualWindowResizeThumbStyle}"
                              DragDelta="ResizeThumb_DragDelta" />
            <primitives:Thumb Tag="BottomRight" Width="8" Height="8"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Cursor="SizeNWSE" Style="{StaticResource ManualWindowResizeThumbStyle}"
                              DragDelta="ResizeThumb_DragDelta" />
        </Grid>
    </Grid>
</Window>
