<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Controls.DateRangeFilterColumnHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             HorizontalAlignment="Stretch">

    <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Header, ElementName=Root}"
                   FontWeight="Bold"
                   Margin="5,0,5,1" />

        <controls:DateRangePicker
            x:Name="FilterPicker"
            IsCompact="True"
            StartDate="{Binding StartDate,
                                ElementName=Root,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
            EndDate="{Binding EndDate,
                              ElementName=Root,
                              Mode=TwoWay,
                              UpdateSourceTrigger=PropertyChanged}"
            Margin="0">

            <controls:DateRangePicker.Style>
                <Style TargetType="{x:Type controls:DateRangePicker}">
                    <Setter Property="Visibility"
                            Value="Collapsed" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFilterVisible, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:DateRangePicker.Style>
        </controls:DateRangePicker>
    </StackPanel>
</UserControl>
