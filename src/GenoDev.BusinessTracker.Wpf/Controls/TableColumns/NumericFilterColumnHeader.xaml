<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Controls.NumericFilterColumnHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls">
    <StackPanel>
        <TextBlock Text="{Binding Header, ElementName=Root}"
                   FontWeight="Bold"
                   Margin="5,0,5,1" />

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFilterVisible, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding AvailableOperators, ElementName=Root}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Operator"
                      SelectedValue="{Binding SelectedOperator,
                                              ElementName=Root,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                      Width="42"
                      Margin="0,0,2,0"
                      Style="{StaticResource CompactFilterComboBoxStyle}"
                      FontWeight="Normal"
                      VerticalContentAlignment="Center" />

            <controls:NumericTextBox x:Name="ValueTextBox"
                                     Grid.Column="1"
                                     Text="{Binding FilterText,
                                                    ElementName=Root,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Value="{Binding FilterValue,
                                                     ElementName=Root,
                                                     Mode=TwoWay}"
                                     IsEnabled="{Binding IsValueInputEnabled, ElementName=Root}"
                                     Margin="0"
                                     Style="{StaticResource CompactFilterNumericTextBoxStyle}"
                                     FontWeight="Normal" />
        </Grid>
    </StackPanel>
</UserControl>
