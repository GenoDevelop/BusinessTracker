<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Controls.BooleanFilterColumnHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Header, ElementName=Root}"
                   FontWeight="Bold"
                   Margin="0,0,0,2" />

        <Grid Visibility="{Binding IsFilterVisible,
                                   ElementName=Root,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                IsThreeState=False:
                    true / false

                IsThreeState=True:
                    true / false / null
            -->
            <CheckBox x:Name="FilterCheckBox"
                      Grid.Column="0"
                      IsChecked="{Binding FilterValue,
                                          ElementName=Root,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                      IsThreeState="{Binding IsNullable, ElementName=Root}"
                      Click="FilterCheckBox_Click"
                      VerticalAlignment="Center"
                      Margin="0,0,5,0" />

            <TextBlock Grid.Column="1"
                       Text="{Binding DisplayText, ElementName=Root}"
                       VerticalAlignment="Center"
                       FontWeight="Normal"
                       MinWidth="35" />

            <Button Grid.Column="2"
                    ToolTip="Wyczyść filtr"
                    Width="28"
                    Height="28"
                    Padding="7"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsFilterActive,
                                         ElementName=Root,
                                         Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="ClearFilter_Click">
                <Path Data="{StaticResource CloseIconGeometry}"
                      Style="{StaticResource ToolbarIconStyle}" />
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
