<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Controls.TextFilterColumnHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Header, ElementName=Root}"
                   FontWeight="Bold"
                   Margin="0,0,0,1" />

        <TextBox Text="{Binding FilterText,
                                ElementName=Root,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                 Margin="0"
                 FontWeight="Normal">
            <TextBox.Style>
                <Style TargetType="TextBox"
                       BasedOn="{StaticResource CompactFilterTextBoxStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFilterVisible, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
    </StackPanel>
</UserControl>
