<Window x:Class="GenoDev.BusinessTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels"
        xmlns:materials="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
        xmlns:production="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Production"
        xmlns:views="clr-namespace:GenoDev.BusinessTracker.Wpf.Views"
        xmlns:sales="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Sales"
        xmlns:salesViews="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Sales"
        xmlns:materialsViews="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Materials"
        xmlns:productionViews="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Production"
        xmlns:notes="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Notes"
        xmlns:notesViews="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Notes"
        xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
        mc:Ignorable="d"
        Title="Business Tracker" Height="768" Width="1024"
        MinHeight="640" MinWidth="900"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type materials:MaterialsViewModel}">
            <materialsViews:MaterialsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type production:ProductionViewModel}">
            <productionViews:ProductionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sales:SalesViewModel}">
            <salesViews:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type notes:NotesViewModel}">
            <notesViews:NotesView />
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <TabControl SelectedIndex="{Binding SelectedMainTabIndex}"
                    Style="{StaticResource TopNavigationTabControlStyle}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource WarehouseNavigationGeometry}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Magazyn" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding MaterialsViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ProductionNavigationGeometry}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Produkcja" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding ProductionViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SalesNavigationGeometry}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Sprzedaż" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding SalesViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource NotesNavigationGeometry}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Notatki" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding NotesViewModel}" />
            </TabItem>
        </TabControl>

        <ToggleButton x:Name="PopupWindowsToggle"
                      Panel.ZIndex="20"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Width="30"
                      Height="30"
                      Margin="0,11,16,0"
                      Padding="3"
                      ToolTipService.ShowOnDisabled="True"
                      ToolTip="Pokaż otwarte okna">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static controls:PopupWindowRegistry.Windows}, Path=Count}"
                                     Value="0">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
            <Grid Width="22" Height="22">
                <Viewbox Width="17" Height="17"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom">
                    <Canvas Width="20" Height="20">
                        <Path Data="M3,6 L15,6 L15,17 L3,17 Z M7,3 L18,3 L18,14"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <Border MinWidth="13"
                        Height="13"
                        Padding="2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static controls:PopupWindowRegistry.Windows}, Path=Count}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Source={x:Static controls:PopupWindowRegistry.Windows}, Path=Count}"
                               Foreground="{DynamicResource OnAccentBrush}"
                               FontSize="8"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </ToggleButton>

        <Popup Panel.ZIndex="21"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=PopupWindowsToggle}"
               HorizontalOffset="-270"
               VerticalOffset="4"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsChecked, ElementName=PopupWindowsToggle, Mode=TwoWay}">
            <Border Width="300"
                    MaxHeight="340"
                    Padding="6"
                    Background="{DynamicResource GlassSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <StaticResource ResourceKey="PopupShadow" />
                </Border.Effect>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Static controls:PopupWindowRegistry.Windows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controls:PopupWindowEntry}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Padding="10,8"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                Click="PopupWindowListItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="4" Height="18"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <controls:TopmostButton Grid.Column="1"
                                                                Width="28"
                                                                Height="28"
                                                                Margin="3,0"
                                                                Padding="4"
                                                                VerticalAlignment="Center"
                                                                IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                                ToolTip="Przypnij lub odepnij okno"
                                                                Click="PopupWindowPin_Click" />
                                        <Button Grid.Column="2"
                                                Width="28"
                                                Height="28"
                                                Margin="0,0,2,0"
                                                Padding="5"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Zamknij okno"
                                                Click="PopupWindowClose_Click">
                                            <Viewbox Width="14" Height="14">
                                                <Canvas Width="20" Height="20">
                                                    <Path Data="M3,3 L17,17 M17,3 L3,17"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>

            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Rectangle Fill="{DynamicResource OverlayBrush}" />
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,22"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Effect>
                        <StaticResource ResourceKey="PopupShadow" />
                    </Border.Effect>
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Width="220" />
                        <TextBlock Text="Ładowanie..."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,13,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
</Window>
