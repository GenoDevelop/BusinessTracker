<Window x:Class="GenoDev.BusinessTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels"
        xmlns:materials="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
        xmlns:production="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Production"
        xmlns:views="clr-namespace:GenoDev.BusinessTracker.Wpf.Views"
        xmlns:sales="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Sales"
        xmlns:salesViews="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Sales"
        xmlns:materialsViews="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Materials"
        xmlns:productionViews="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Production"
        xmlns:notes="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Notes"
        xmlns:notesViews="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Notes"
        xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Business Tracker" Height="768" Width="1024"
        Foreground="{DynamicResource TextPrimaryBrush}"
        MinHeight="640" MinWidth="900"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="MainWindow_StateChanged"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type materials:MaterialsViewModel}">
            <materialsViews:MaterialsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type production:ProductionViewModel}">
            <productionViews:ProductionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sales:SalesViewModel}">
            <salesViews:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type notes:NotesViewModel}">
            <notesViews:NotesView />
        </DataTemplate>
        <Style x:Key="ApplicationCaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource IconForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource IconHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ApplicationCloseButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ApplicationCaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerButtonHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="MainWindowBorder"
            Background="{DynamicResource GlassSurfaceBrush}">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource GlassSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Border Background="{DynamicResource GlassSheenBrush}"
                        IsHitTestVisible="False" />
                <StackPanel Margin="18,0,300,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="4"
                            Height="22"
                            Margin="0,0,12,0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="2" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Margin="0,-2,0,0"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedMainTabIndex}"
                    Style="{StaticResource TopNavigationTabControlStyle}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource WarehouseNavigationGeometry}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Magazyn" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding MaterialsViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ProductionNavigationGeometry}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Produkcja" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding ProductionViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SalesNavigationGeometry}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Sprzedaż" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding SalesViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource NotesNavigationGeometry}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Notatki" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding NotesViewModel}" />
            </TabItem>
        </TabControl>

        <controls:TopmostButton x:Name="MainWindowTopmostButton"
                                Grid.Row="0"
                                Panel.ZIndex="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="30"
                                Height="30"
                                Margin="0,0,222,0"
                                Padding="5"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Checked="MainWindowTopmostButton_CheckedChanged"
                                Unchecked="MainWindowTopmostButton_CheckedChanged" />

        <Button x:Name="ThemeButton"
                Grid.Row="0"
                Panel.ZIndex="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="30"
                Height="30"
                Margin="0,0,184,0"
                Padding="5"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                AutomationProperties.Name="Zmień motyw"
                Click="ThemeButton_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                    <Setter Property="ToolTip" Value="Włącz motyw ciemny" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDark, Source={StaticResource ThemeSettings}}"
                                     Value="True">
                            <Setter Property="ToolTip" Value="Włącz motyw jasny" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.7"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent"
                  Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Data" Value="M20,14 A8.5,8.5 0 1 1 10,4 A7,7 0 0 0 20,14 Z" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDark, Source={StaticResource ThemeSettings}}"
                                         Value="True">
                                <Setter Property="Data" Value="M12,7 A5,5 0 1 1 12,17 A5,5 0 1 1 12,7 M12,1 L12,3 M12,21 L12,23 M1,12 L3,12 M21,12 L23,12 M4,4 L5.5,5.5 M18.5,18.5 L20,20 M4,20 L5.5,18.5 M18.5,5.5 L20,4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </Button>

        <ToggleButton x:Name="PopupWindowsToggle"
                      Grid.Row="0"
                      Panel.ZIndex="20"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Width="30"
                      Height="30"
                      Margin="0,0,146,0"
                      Padding="3"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      ToolTipService.ShowOnDisabled="True"
                      ToolTip="Pokaż otwarte okna">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static controls:PopupWindowRegistry.Windows}, Path=Count}"
                                     Value="0">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
            <Grid Width="22" Height="22">
                <Viewbox Width="17" Height="17"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom">
                    <Canvas Width="20" Height="20">
                        <Path Data="M3,6 L15,6 L15,17 L3,17 Z M7,3 L18,3 L18,14"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <Border MinWidth="13"
                        Height="13"
                        Padding="2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static controls:PopupWindowRegistry.Windows}, Path=Count}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Source={x:Static controls:PopupWindowRegistry.Windows}, Path=Count}"
                               Foreground="{DynamicResource OnAccentBrush}"
                               FontSize="8"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </ToggleButton>

        <Button Grid.Row="0"
                Panel.ZIndex="20"
                HorizontalAlignment="Right"
                Margin="0,0,92,0"
                Style="{StaticResource ApplicationCaptionButtonStyle}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="Minimalizuj"
                AutomationProperties.Name="Minimalizuj"
                Click="MinimizeButton_Click">
            <Path Width="12"
                  Height="12"
                  Data="M2,10 L10,10"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Square"
                  Stretch="Uniform" />
        </Button>

        <Button Grid.Row="0"
                Panel.ZIndex="20"
                HorizontalAlignment="Right"
                Margin="0,0,46,0"
                Style="{StaticResource ApplicationCaptionButtonStyle}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="Maksymalizuj lub przywróć"
                AutomationProperties.Name="Maksymalizuj lub przywróć"
                Click="MaximizeRestoreButton_Click">
            <Path Width="12"
                  Height="12"
                  Fill="Transparent"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.35"
                  StrokeLineJoin="Miter"
                  Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="{x:Type Path}">
                        <Setter Property="Data" Value="M2,2 L10,2 L10,10 L2,10 Z" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="Maximized">
                                <Setter Property="Data" Value="M4,1 L11,1 L11,8 M1,4 L8,4 L8,11 L1,11 Z" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </Button>

        <Button Grid.Row="0"
                Panel.ZIndex="20"
                HorizontalAlignment="Right"
                Style="{StaticResource ApplicationCloseButtonStyle}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="Zamknij"
                AutomationProperties.Name="Zamknij"
                Click="CloseButton_Click">
            <Path Width="12"
                  Height="12"
                  Data="M2,2 L10,10 M10,2 L2,10"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Square"
                  StrokeEndLineCap="Square"
                  Stretch="Uniform" />
        </Button>

        <Popup Panel.ZIndex="21"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=PopupWindowsToggle}"
               HorizontalOffset="-270"
               VerticalOffset="4"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsChecked, ElementName=PopupWindowsToggle, Mode=TwoWay}">
            <Border Width="300"
                    MaxHeight="340"
                    Padding="6"
                    Background="{DynamicResource GlassSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <StaticResource ResourceKey="PopupShadow" />
                </Border.Effect>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Static controls:PopupWindowRegistry.Windows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type controls:PopupWindowEntry}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Padding="10,8"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                Click="PopupWindowListItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="4" Height="18"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <controls:TopmostButton Grid.Column="1"
                                                                Width="28"
                                                                Height="28"
                                                                Margin="3,0"
                                                                Padding="4"
                                                                VerticalAlignment="Center"
                                                                IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                                ToolTip="Przypnij lub odepnij okno"
                                                                Click="PopupWindowPin_Click" />
                                        <Button Grid.Column="2"
                                                Width="28"
                                                Height="28"
                                                Margin="0,0,2,0"
                                                Padding="5"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Zamknij okno"
                                                Click="PopupWindowClose_Click">
                                            <Viewbox Width="14" Height="14">
                                                <Canvas Width="20" Height="20">
                                                    <Path Data="M3,3 L17,17 M17,3 L3,17"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>

            <Grid Grid.RowSpan="2"
                  Panel.ZIndex="30"
                  Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Rectangle Fill="{DynamicResource OverlayBrush}" />
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,22"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Effect>
                        <StaticResource ResourceKey="PopupShadow" />
                    </Border.Effect>
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Width="220" />
                        <TextBlock Text="Ładowanie..."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,13,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
