                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
