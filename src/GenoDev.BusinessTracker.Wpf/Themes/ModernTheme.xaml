    <Style x:Key="SideNavigationTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SideNavigationTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="NavigationColumn" Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource NavigationSurfaceBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TabPanel Margin="0,9,0,0"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" />
                                <Button Grid.Row="1"
                                        Width="34"
                                        Height="34"
                                        Margin="8,4,0,10"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ToggleCompactModeCommand, Source={StaticResource SideNavigationSettings}}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource IconButton}">
                                            <Setter Property="ToolTip" Value="Włącz tryb kompaktowy" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompact, Source={StaticResource SideNavigationSettings}}"
                                                             Value="True">
                                                    <Setter Property="ToolTip" Value="Wyłącz tryb kompaktowy" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Path Data="{StaticResource CollapseNavigationIconGeometry}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}"
                                                       BasedOn="{StaticResource ToolbarIconStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompact, Source={StaticResource SideNavigationSettings}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Path Data="{StaticResource ExpandNavigationIconGeometry}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}"
                                                       BasedOn="{StaticResource ToolbarIconStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompact, Source={StaticResource SideNavigationSettings}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectedContentStringFormat}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, Source={StaticResource SideNavigationSettings}}"
                                     Value="True">
                            <Setter TargetName="NavigationColumn" Property="Width" Value="52" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetailNavigationTabItemStyle" TargetType="{x:Type TabItem}">
