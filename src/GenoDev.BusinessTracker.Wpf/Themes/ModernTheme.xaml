<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls">

    <!-- Calm, high-contrast application palette. -->
    <Color x:Key="AppBackgroundColor">#F4F7F8</Color>
    <Color x:Key="NavigationSurfaceColor">#EEF3F4</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAlternativeColor">#F1F5F6</Color>
    <Color x:Key="SurfaceHoverColor">#EDF3F4</Color>
    <Color x:Key="SurfaceSelectedColor">#E2F0F1</Color>
    <Color x:Key="BorderColor">#CEDBDD</Color>
    <Color x:Key="BorderStrongColor">#B8C8CC</Color>
    <Color x:Key="TextPrimaryColor">#172A30</Color>
    <Color x:Key="TextSecondaryColor">#435B63</Color>
    <Color x:Key="TextDisabledColor">#82969C</Color>
    <Color x:Key="AccentColor">#117782</Color>
    <Color x:Key="AccentHoverColor">#0D6872</Color>
    <Color x:Key="AccentPressedColor">#09545D</Color>
    <Color x:Key="SelectedTabTextColor">#063F47</Color>
    <Color x:Key="AccentSoftColor">#DFF0F2</Color>
    <Color x:Key="AccentMutedColor">#A9D2D6</Color>
    <Color x:Key="FocusColor">#2696A1</Color>
    <Color x:Key="DangerColor">#C94B61</Color>
    <Color x:Key="DangerHoverColor">#B73C52</Color>
    <Color x:Key="DangerSoftColor">#FCECEF</Color>
    <Color x:Key="SuccessColor">#188363</Color>
    <Color x:Key="SuccessSoftColor">#E1F3EC</Color>
    <Color x:Key="WarningColor">#AE6B20</Color>
    <Color x:Key="WarningSoftColor">#FCF0DE</Color>
    <Color x:Key="SupplyStatusNewColor">#343A40</Color>
    <Color x:Key="SupplyStatusOrderedColor">#3B82F6</Color>
    <Color x:Key="SupplyStatusReceivedColor">#22C55E</Color>
    <Color x:Key="OrderStatusShippedColor">#D946EF</Color>

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F8FAFA" />
        <GradientStop Offset="0.48" Color="#F2F7F7" />
        <GradientStop Offset="1" Color="#EAF2F3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F4FFFFFF" />
        <GradientStop Offset="0.55" Color="#EAF4F8F8" />
        <GradientStop Offset="1" Color="#DDE8F1F2" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAlternativeBrush" Color="{StaticResource SurfaceAlternativeColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SelectedTabTextBrush" Color="{StaticResource SelectedTabTextColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />

    <Thickness x:Key="DetailPaneMargin">10</Thickness>
    <SolidColorBrush x:Key="SupplyStatusNewBrush" Color="{StaticResource SupplyStatusNewColor}" />
    <SolidColorBrush x:Key="SupplyStatusOrderedBrush" Color="{StaticResource SupplyStatusOrderedColor}" />
    <SolidColorBrush x:Key="SupplyStatusReceivedBrush" Color="{StaticResource SupplyStatusReceivedColor}" />
    <SolidColorBrush x:Key="OrderStatusShippedBrush" Color="{StaticResource OrderStatusShippedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#5C122127" />
    <SolidColorBrush x:Key="TableGridLineBrush" Color="#EAF0F1" />

    <!-- One shared state keeps every module navigation rail in the same mode. -->
    <controls:SideNavigationSettings x:Key="SideNavigationSettings" />

    <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFFFFFF" />
        <GradientStop Offset="0.45" Color="#F8F8FBFB" />
        <GradientStop Offset="1" Color="#EEF0F6F7" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#EFFFFFFF" />
        <GradientStop Offset="0.48" Color="#7FA9D2D6" />
        <GradientStop Offset="1" Color="#BFFFFFFF" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="GlassSheenBrush"
                         Center="0.18,0.08"
                         GradientOrigin="0.18,0.08"
                         RadiusX="0.9"
                         RadiusY="1.2">
        <GradientStop Offset="0" Color="#AFFFFFFF" />
        <GradientStop Offset="0.42" Color="#24FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="PopupShadow"
                      x:Shared="False"
                      BlurRadius="30"
                      Direction="270"
                      ShadowDepth="8"
                      Color="#15292F"
                      Opacity="0.2" />
    <DropShadowEffect x:Key="CardShadow"
                      x:Shared="False"
                      BlurRadius="18"
                      Direction="270"
                      ShadowDepth="3"
                      Color="#163038"
                      Opacity="0.1" />

    <!-- Navigation geometries. -->
    <Geometry x:Key="WarehouseNavigationGeometry">M3,8 L12,3 L21,8 L21,20 L3,20 Z M3,8 L12,13 L21,8 M12,13 L12,20</Geometry>
    <Geometry x:Key="ProductionNavigationGeometry">M4,20 L4,10 L9,13 L9,8 L14,11 L14,5 L20,8 L20,20 Z M8,17 L10,17 M14,17 L16,17</Geometry>
    <Geometry x:Key="SalesNavigationGeometry">M5,8 L19,8 L18,21 L6,21 Z M9,9 L9,7 C9,3 15,3 15,7 L15,9</Geometry>
    <Geometry x:Key="NotesNavigationGeometry">M5,3 L17,3 C18.1,3 19,3.9 19,5 L19,19 C19,20.1 18.1,21 17,21 L5,21 Z M8,7 L16,7 M8,11 L16,11 M8,15 L13,15</Geometry>
    <Geometry x:Key="MaterialsNavigationGeometry">M12,3 L21,8 L12,13 L3,8 Z M3,12 L12,17 L21,12 M3,16 L12,21 L21,16</Geometry>
    <Geometry x:Key="PackageNavigationGeometry">M4,7 L12,3 L20,7 L20,17 L12,21 L4,17 Z M4,7 L12,11 L20,7 M12,11 L12,21</Geometry>
    <Geometry x:Key="AssetsNavigationGeometry">M4,8 L20,8 L20,20 L4,20 Z M8,8 L8,5 L16,5 L16,8 M4,13 L20,13 M10,13 L10,15 L14,15 L14,13</Geometry>
    <Geometry x:Key="SuppliersNavigationGeometry">M4,20 L4,7 L14,7 L14,20 M14,11 L19,11 L21,15 L21,20 L14,20 M7,11 L11,11 M7,15 L11,15</Geometry>
    <Geometry x:Key="DeliveriesNavigationGeometry">M3,6 L14,6 L14,17 L3,17 Z M14,10 L18,10 L21,14 L21,17 L14,17 M7,20 A2,2 0 1 0 7,16 A2,2 0 1 0 7,20 M18,20 A2,2 0 1 0 18,16 A2,2 0 1 0 18,20</Geometry>
    <Geometry x:Key="AdjustmentsNavigationGeometry">M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M9,3 L9,9 M15,9 L15,15 M11,15 L11,21</Geometry>
    <Geometry x:Key="ProductsNavigationGeometry">M4,7 L12,3 L20,7 L20,17 L12,21 L4,17 Z M4,7 L12,11 L20,7</Geometry>
    <Geometry x:Key="RecipesNavigationGeometry">M6,3 L16,3 L20,7 L20,21 L6,21 Z M16,3 L16,8 L20,8 M9,12 L17,12 M9,16 L17,16</Geometry>
    <Geometry x:Key="OrdersNavigationGeometry">M6,3 L18,3 L18,21 L15,19 L12,21 L9,19 L6,21 Z M9,8 L15,8 M9,12 L15,12 M9,16 L13,16</Geometry>

    <!-- Shared interface icons. Keeping these as vectors avoids font-glyph inconsistencies. -->
    <Geometry x:Key="SearchIconGeometry">M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 M15.2,15.2 L20,20</Geometry>
    <Geometry x:Key="CalendarIconGeometry">M5,5 L19,5 C20.1,5 21,5.9 21,7 L21,20 L3,20 L3,7 C3,5.9 3.9,5 5,5 Z M7,3 L7,7 M17,3 L17,7 M3,10 L21,10</Geometry>
    <Geometry x:Key="CloseIconGeometry">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="AlignLeftIconGeometry">M5,6 L19,6 M5,10 L15,10 M5,14 L19,14 M5,18 L13,18</Geometry>
    <Geometry x:Key="AlignCenterIconGeometry">M5,6 L19,6 M7,10 L17,10 M5,14 L19,14 M8,18 L16,18</Geometry>
    <Geometry x:Key="AlignRightIconGeometry">M5,6 L19,6 M9,10 L19,10 M5,14 L19,14 M11,18 L19,18</Geometry>
    <Geometry x:Key="BulletsIconGeometry">M4,7 L4.1,7 M4,12 L4.1,12 M4,17 L4.1,17 M8,7 L20,7 M8,12 L20,12 M8,17 L17,17</Geometry>
    <Geometry x:Key="CheckIconGeometry">M4,12 L9,17 L20,6</Geometry>
    <Geometry x:Key="SortAscendingIconGeometry">M2,6 L6,2 L10,6</Geometry>
    <Geometry x:Key="SortDescendingIconGeometry">M2,2 L6,6 L10,2</Geometry>
    <Geometry x:Key="CollapseNavigationIconGeometry">M11,5 L4,12 L11,19 M20,5 L13,12 L20,19</Geometry>
    <Geometry x:Key="ExpandNavigationIconGeometry">M4,5 L11,12 L4,19 M13,5 L20,12 L13,19</Geometry>

    <Style x:Key="NavigationIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
    </Style>

    <Style x:Key="ToolbarIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Base typography and page-level styles. TextBlock deliberately inherits Foreground. -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MasterListTitleTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SectionTitleTextStyle}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <Style x:Key="GlassToolbarBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <Style x:Key="MasterListToolbarBorderStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource GlassToolbarBorderStyle}">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <Style x:Key="GlassInsetBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="ReadOnlyDescriptionBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="0,0,0,5" />
    </Style>

    <ControlTemplate x:Key="RequestValidationErrorTemplate">
        <StackPanel>
            <AdornedElementPlaceholder x:Name="adorner" />
            <ItemsControl ItemsSource="{Binding ElementName=adorner, Path=AdornedElement.(Validation.Errors)}"
                          Foreground="{DynamicResource DangerBrush}"
                          FontSize="11"
                          Margin="3,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ControlTemplate>

    <!-- Buttons: hover overlays stay inside the control; controls never scale outside their box. -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid ClipToBounds="True">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="HoverOverlay"
                                Margin="1"
                                Background="{DynamicResource TextPrimaryBrush}"
                                CornerRadius="7"
                                Opacity="0" />
                        <ContentPresenter x:Name="ButtonContent"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}" />
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.055" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.12" />
                            <Setter TargetName="ButtonContent" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceAlternativeBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.62" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid ClipToBounds="True">
                        <Border x:Name="HoverSurface"
                                Margin="1"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentMutedBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Opacity="0" />
                        <ContentPresenter x:Name="IconContent"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="HoverSurface" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="IconContent" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.34" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionIconButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid ClipToBounds="True">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <Border x:Name="HoverOverlay"
                                Margin="1"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="7"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.58" />
                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggleButton" TargetType="{x:Type ToggleButton}">
