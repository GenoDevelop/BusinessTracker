                            <Border x:Name="ActiveIndicator"
                                    Width="3"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="2"
                                    Opacity="0" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedTabTextBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCompact, Source={StaticResource SideNavigationSettings}}"
                                     Value="True">
                            <Setter Property="Margin" Value="4,2" />
                            <Setter Property="MinWidth" Value="44" />
                            <Setter TargetName="HeaderPresenter"
                                    Property="HorizontalAlignment"
                                    Value="Center" />
