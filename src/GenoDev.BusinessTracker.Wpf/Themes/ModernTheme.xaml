    <Style TargetType="{x:Type controls:SideNavigationHeader}">
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SideNavigationHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="HeaderIcon"
                              Data="{TemplateBinding Icon}"
                              Style="{StaticResource NavigationIconStyle}"
                              Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderText"
                                   Text="{TemplateBinding Text}"
                                   TextAlignment="Left"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, Source={StaticResource SideNavigationSettings}}"
                                     Value="True">
                            <Setter TargetName="HeaderIcon" Property="Margin" Value="0" />
                            <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideNavigationTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,11" />
        <Setter Property="Margin" Value="7,2" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="MinHeight" Value="43" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Margin="2"
                          Background="Transparent"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="TabSurface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
