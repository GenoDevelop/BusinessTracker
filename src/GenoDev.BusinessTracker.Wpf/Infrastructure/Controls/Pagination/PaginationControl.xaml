<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Infrastructure.Controls.PaginationControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Infrastructure.Controls"
             HorizontalContentAlignment="Stretch"
             mc:Ignorable="d"
             d:DesignWidth="520"
             d:DesignHeight="60">
    <Grid>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="{Binding PaginationHorizontalAlignment, ElementName=Root}"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Layout, ElementName=Root}"
                                     Value="{x:Static controls:PaginationLayout.SingleLine}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock VerticalAlignment="Center" Margin="10,0">
                <Run Text="{Binding ItemsRangeLabel, ElementName=Root}" />
                <Run Text=" " />
                <Run Text="{Binding ItemsRange, ElementName=Root, Mode=OneWay}" />
            </TextBlock>

            <TextBlock VerticalAlignment="Center"
                       Margin="10,0"
                       Text="{Binding PageSizeLabel, ElementName=Root}" />

            <ComboBox ItemsSource="{Binding AvailablePageSizes, ElementName=Root}"
                      SelectedItem="{Binding PageSize, ElementName=Root, Mode=OneWay}"
                      SelectionChanged="PageSizeComboBox_SelectionChanged"
                      IsEnabled="{Binding CanChangePageSize, ElementName=Root}"
                      VerticalAlignment="Center"
                      Width="60" />

            <controls:ArrowLeftButton Click="PreviousButton_Click"
                                      IsEnabled="{Binding CanGoPrevious, ElementName=Root}"
                                      Margin="5,0"
                                      ToolTip="{Binding PreviousToolTip, ElementName=Root}"
                                      AutomationProperties.Name="{Binding PreviousToolTip, ElementName=Root}"
                                      Width="20"/>

            <TextBlock VerticalAlignment="Center" Margin="10,0">
                <Run Text="{Binding PageLabel, ElementName=Root}" />
                <Run Text=" " />
                <Run Text="{Binding DisplayPage, ElementName=Root, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding OfLabel, ElementName=Root}" />
                <Run Text=" " />
                <Run Text="{Binding TotalPages, ElementName=Root, Mode=OneWay}" />
            </TextBlock>

            <controls:ArrowRightButton Click="NextButton_Click"
                                       IsEnabled="{Binding CanGoNext, ElementName=Root}"
                                       Margin="5,0"
                                       ToolTip="{Binding NextToolTip, ElementName=Root}"
                                       AutomationProperties.Name="{Binding NextToolTip, ElementName=Root}"
                                       Width="20" />
        </StackPanel>

        <Grid HorizontalAlignment="Stretch">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Layout, ElementName=Root}"
                                     Value="{x:Static controls:PaginationLayout.CompactTwoRows}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:ArrowLeftButton
                Grid.Row="0"
                Grid.Column="0"
                Click="PreviousButton_Click"
                IsEnabled="{Binding CanGoPrevious, ElementName=Root}"
                ToolTip="{Binding PreviousToolTip, ElementName=Root}"
                AutomationProperties.Name="{Binding PreviousToolTip, ElementName=Root}"
                Width="18"/>

            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                <Run Text="{Binding DisplayPage, ElementName=Root, Mode=OneWay}" />
                <Run Text="/" />
                <Run Text="{Binding TotalPages, ElementName=Root, Mode=OneWay}" />
            </TextBlock>

            <controls:ArrowRightButton
                Grid.Row="0"
                Grid.Column="2"
                Click="NextButton_Click"
                IsEnabled="{Binding CanGoNext, ElementName=Root}"
                ToolTip="{Binding NextToolTip, ElementName=Root}"
                AutomationProperties.Name="{Binding NextToolTip, ElementName=Root}"
                Width="18"/>

            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,-5">
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding PageSizeLabel, ElementName=Root}"
                           Margin="0,0,5,0" />

                <ComboBox ItemsSource="{Binding AvailablePageSizes, ElementName=Root}"
                          SelectedItem="{Binding PageSize, ElementName=Root, Mode=OneWay}"
                          SelectionChanged="PageSizeComboBox_SelectionChanged"
                          IsEnabled="{Binding CanChangePageSize, ElementName=Root}"
                          VerticalAlignment="Center"
                          Width="45"
                          Height="22" />

                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                    <Run Text="{Binding CompactItemsRangeLabel, ElementName=Root}" />
                    <Run Text=" " />
                    <Run Text="{Binding ItemsRange, ElementName=Root, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
