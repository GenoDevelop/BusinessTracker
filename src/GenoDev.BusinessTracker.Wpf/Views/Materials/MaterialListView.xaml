<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Materials.MaterialListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:MaterialListViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="MaterialEditorTemplate">
            <StackPanel Width="400">
                <TextBlock Text="Nazwa (wymagane):" Margin="0,0,0,5" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                <TextBlock Text="Opis:" Margin="0,0,0,5" />
                <controls:ResizableTextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                           AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap"
                                           VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="15,5" />
                    <Button Content="Zapisz" Command="{Binding SaveCommand}" Padding="15,5"
                            Background="{DynamicResource PrimaryButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MaterialVariantEditorTemplate">
            <controls:InventoryItemEditor />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Materials -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Style="{StaticResource GlassToolbarBorderStyle}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Materiały"
                               Style="{StaticResource PageTitleTextStyle}"
                               Margin="0,0,20,0" />
                    <controls:CreateButton Command="{Binding CreateMaterialCommand}"
                                           ToolTip="Dodaj materiał"
                                           Margin="0,0,2,0" />
                    <controls:RefreshButton Click="RefreshButton_Click"
                                            Margin="0,0,2,0" />
                    <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Click="FilterToggleButton_Click" />
                </StackPanel>
                </Border>

                <controls:ConfigurableDataGrid x:Name="MaterialsDataGrid"
                          Grid.Row="1"
                          LayoutKey="Materials.MaterialsGrid"
                          ItemsSource="{Binding Materials}"
                          SelectedItem="{Binding SelectedMaterial}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          ColumnVisibilityChanged="MaterialsDataGrid_ColumnVisibilityChanged"
                          Sorting="MaterialsDataGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"
                                            Visibility="Collapsed" CanUserSort="False"
                                            controls:ConfigurableDataGrid.ColumnKey="Id"
                                            ElementStyle="{StaticResource TechnicalIdDataGridCellTextStyle}"
                                            HeaderTemplate="{StaticResource TechnicalIdDataGridHeaderTemplate}"
                                            controls:ConfigurableDataGrid.ColumnTitle="ID" />
                        <DataGridTemplateColumn Width="*" SortMemberPath="Name"
                                                controls:ConfigurableDataGrid.ColumnKey="Name"
                                                controls:ConfigurableDataGrid.ColumnTitle="Nazwa">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    x:Name="NameFilterColumn"
                                    Header="Nazwa"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="MaterialsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Margin="5,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Width="150" SortMemberPath="VariantsCount"
                                                controls:ConfigurableDataGrid.ColumnKey="VariantsCount"
                                                controls:ConfigurableDataGrid.ColumnTitle="Liczba wariantów">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="VariantsCountFilterColumn"
                                    Header="Liczba wariantów"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="MaterialsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VariantsCount}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="5,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Width="2*" SortMemberPath="Description"
                                                controls:ConfigurableDataGrid.ColumnKey="Description"
                                                controls:ConfigurableDataGrid.ColumnTitle="Opis">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    x:Name="DescriptionFilterColumn"
                                    Header="Opis"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="MaterialsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="5,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto" MinWidth="72"
                                                controls:ConfigurableDataGrid.ColumnKey="Actions"
                                                controls:ConfigurableDataGrid.ColumnTitle="Akcje">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Akcje"
                                           FontWeight="Bold"
                                           Margin="5,0" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <controls:EditButton
                                            Command="{Binding DataContext.EditMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Edytuj materiał"
                                            Margin="1,0" />
                                        <controls:DeleteButton
                                            Command="{Binding DataContext.DeleteMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Usuń materiał"
                                            Margin="1,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </controls:ConfigurableDataGrid>

                <!-- Pagination for Materials -->
                <controls:PaginationControl x:Name="MaterialsPagination"
                                            Grid.Row="2"
                                            Layout="SingleLine"
                                            PageLoader="{Binding MaterialsPageLoader}"
                                            InitialPageSize="20"
                                            HorizontalAlignment="Right"
                                            PaginationHorizontalAlignment="Right"
                                            Margin="0,5,0,0" />
            </Grid>

            <controls:RatioGridSplitter Grid.Row="1" />

            <!-- Material Variants -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource GlassToolbarBorderStyle}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Warianty"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,20,0" />
                    <controls:CreateButton Command="{Binding CreateMaterialVariantCommand}"
                                           ToolTip="Dodaj wariant"
                                           Margin="0,0,2,0" />
                    <controls:RefreshButton Click="VariantsRefreshButton_Click"
                                            Margin="0,0,2,0" />
                    <controls:FilterToggleButton IsChecked="{Binding IsVariantFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Click="VariantFilterToggleButton_Click" />
                </StackPanel>
                </Border>

                <controls:ConfigurableDataGrid x:Name="VariantsDataGrid"
                          Grid.Row="1"
                          LayoutKey="Materials.MaterialVariantsGrid"
                          ItemsSource="{Binding MaterialVariants}"
                          SelectedItem="{Binding SelectedMaterialVariant}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          ColumnVisibilityChanged="VariantsDataGrid_ColumnVisibilityChanged"
                          Sorting="VariantsDataGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"
                                            Visibility="Collapsed" CanUserSort="False"
                                            controls:ConfigurableDataGrid.ColumnKey="Id"
                                            ElementStyle="{StaticResource TechnicalIdDataGridCellTextStyle}"
                                            HeaderTemplate="{StaticResource TechnicalIdDataGridHeaderTemplate}"
                                            controls:ConfigurableDataGrid.ColumnTitle="ID" />
                        <DataGridTemplateColumn Width="*" SortMemberPath="Name">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    x:Name="VariantNameFilterColumn"
                                    Header="Nazwa"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsVariantFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="VariantsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Margin="5,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="120" SortMemberPath="Ean">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    x:Name="VariantEanFilterColumn"
                                    Header="EAN"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsVariantFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="VariantsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Ean}"
                                               VerticalAlignment="Center"
                                               Margin="5,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="150" SortMemberPath="ManufacturerCode">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    x:Name="VariantManufacturerCodeFilterColumn"
                                    Header="Kod producenta"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsVariantFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="VariantsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ManufacturerCode}"
                                               VerticalAlignment="Center"
                                               Margin="5,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="120" SortMemberPath="Amount">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="VariantAmountFilterColumn"
                                    Header="Ilość"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsVariantFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="VariantsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" Margin="5,0">
                                        <Run Text="{Binding TotalCompanyAmount, Mode=OneWay}" /><TextBlock Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                        </TextBlock><TextBlock Visibility="{Binding TotalPrivateAmount, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center">
                                            <Run Text=" "/><Run Text="+" />
                                            <Run Text="{Binding TotalPrivateAmount, Mode=OneWay}" />
                                        </TextBlock>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="130" SortMemberPath="TotalUsedAmount">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="VariantTotalUsedAmountFilterColumn"
                                    Header="Zużyto"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsVariantFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="VariantsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                        <TextBlock Text="{Binding TotalUsedAmount}" />
                                        <TextBlock Text=" " />
                                        <TextBlock Text="{Binding Unit}" Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="2*" SortMemberPath="Description">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    x:Name="VariantDescriptionFilterColumn"
                                    Header="Opis"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsVariantFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="VariantsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="5,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto" MinWidth="72"
                                                controls:ConfigurableDataGrid.ColumnKey="Actions">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Akcje"
                                           FontWeight="Bold"
                                           Margin="5,0" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <controls:EditButton Command="{Binding DataContext.EditMaterialVariantCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                             CommandParameter="{Binding}"
                                                             ToolTip="Edytuj wariant"
                                                             Margin="1,0" />
                                        <controls:DeleteButton Command="{Binding DataContext.DeleteMaterialVariantCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Usuń wariant"
                                                               Margin="1,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </controls:ConfigurableDataGrid>

                <!-- Pagination for Variants -->
                <controls:PaginationControl x:Name="VariantsPagination"
                                            Grid.Row="2"
                                            Layout="SingleLine"
                                            PageLoader="{Binding MaterialVariantsPageLoader}"
                                            InitialPageSize="20"
                                            HorizontalAlignment="Right"
                                            PaginationHorizontalAlignment="Right"
                                            Margin="0,5,0,0" />
            </Grid>
        </Grid>

        <!-- Create Material -->
        <controls:PopupWindowHost IsOpen="{Binding IsCreatePopupOpen}"
                                 Title="{Binding CreateMaterialViewModel.Title}"
                                 StaysOpen="True">
            <ContentControl Content="{Binding CreateMaterialViewModel}"
                            ContentTemplate="{StaticResource MaterialEditorTemplate}" />
        </controls:PopupWindowHost>

        <!-- Edit Material -->
        <controls:PopupWindowHost IsOpen="{Binding IsEditPopupOpen}"
                                  Title="{Binding EditMaterialViewModel.Title}"
                                  StaysOpen="True">
            <ContentControl Content="{Binding EditMaterialViewModel}"
                            ContentTemplate="{StaticResource MaterialEditorTemplate}" />
        </controls:PopupWindowHost>

        <!-- Create Material Variant -->
        <controls:PopupWindowHost IsOpen="{Binding IsCreateVariantPopupOpen}"
                                 Title="{Binding CreateMaterialVariantViewModel.Title}"
                                 StaysOpen="True">
            <ContentControl Content="{Binding CreateMaterialVariantViewModel}"
                            ContentTemplate="{StaticResource MaterialVariantEditorTemplate}" />
        </controls:PopupWindowHost>

        <!-- Edit Material Variant -->
        <controls:PopupWindowHost IsOpen="{Binding IsEditVariantPopupOpen}"
                                  Title="{Binding EditMaterialVariantViewModel.Title}"
                                  StaysOpen="True">
            <ContentControl Content="{Binding EditMaterialVariantViewModel}"
                            ContentTemplate="{StaticResource MaterialVariantEditorTemplate}" />
        </controls:PopupWindowHost>

        <!-- Delete Confirmation -->
        <controls:PopupWindowHost IsOpen="{Binding IsDeletePopupOpen}"
                                 Title="Usuń materiał"
                                 StaysOpen="True">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                    <Run Text="Czy na pewno chcesz usunąć materiał " />
                    <Run Text="{Binding MaterialToDelete.Name, Mode=OneWay}"
                         FontWeight="Bold" />
                    <Run Text="?" />
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Anuluj"
                            Command="{Binding CancelDeleteCommand}"
                            Margin="0,0,10,0"
                            Padding="15,5" />
                    <Button Content="Usuń"
                            Command="{Binding ConfirmDeleteCommand}"
                            Padding="15,5"
                            Background="{DynamicResource DangerButtonBackgroundBrush}"
                            Foreground="{DynamicResource DangerButtonForegroundBrush}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:PopupWindowHost>

        <!-- Delete Variant Confirmation -->
        <controls:PopupWindowHost IsOpen="{Binding IsDeleteVariantPopupOpen}"
                                 Title="Usuń wariant materiału"
                                 StaysOpen="True">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                    <Run Text="Czy na pewno chcesz usunąć wariant " />
                    <Run Text="{Binding VariantToDelete.Name, Mode=OneWay}"
                         FontWeight="Bold" />
                    <Run Text="?" />
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Anuluj"
                            Command="{Binding CancelDeleteCommand}"
                            Margin="0,0,10,0"
                            Padding="15,5" />
                    <Button Content="Usuń"
                            Command="{Binding ConfirmDeleteCommand}"
                            Padding="15,5"
                            Background="{DynamicResource DangerButtonBackgroundBrush}"
                            Foreground="{DynamicResource DangerButtonForegroundBrush}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:PopupWindowHost>
    </Grid>
</UserControl>
