<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Materials.PackingMaterialListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:PackingMaterialListViewModel}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Style="{StaticResource GlassToolbarBorderStyle}" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Pakunki"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,20,0" />
            <controls:CreateButton Command="{Binding CreateCommand}"
                                   ToolTip="Dodaj pakunek"
                                   Margin="0,0,2,0" />
            <controls:RefreshButton Click="RefreshButton_Click"
                                    Margin="0,0,2,0" />
            <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Click="FilterToggleButton_Click" />
        </StackPanel>
        </Border>

        <!-- Packing Materials Table -->
        <controls:ConfigurableDataGrid x:Name="PackingMaterialsDataGrid"
                  Grid.Row="1"
                  LayoutKey="Materials.PackingMaterialsGrid"
                  ItemsSource="{Binding PackingMaterials}"
                  SelectedItem="{Binding SelectedPackingMaterial}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  ColumnVisibilityChanged="DataGrid_ColumnVisibilityChanged"
                  Sorting="DataGrid_Sorting">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="NameFilterColumn"
                            Header="Nazwa"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="120" SortMemberPath="Ean">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="EanFilterColumn"
                            Header="EAN"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Ean}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="150" SortMemberPath="ManufacturerCode">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="ManufacturerCodeFilterColumn"
                            Header="Kod producenta"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ManufacturerCode}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="150" SortMemberPath="Amount">
                    <DataGridTemplateColumn.Header>
                        <controls:NumericFilterColumnHeader
                            x:Name="AmountFilterColumn"
                            Header="Ilość"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Margin="5,0">
                                <Run Text="{Binding TotalCompanyAmount, Mode=OneWay}" /><TextBlock Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                </TextBlock><TextBlock Visibility="{Binding TotalPrivateAmount, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center">
                                    <Run Text=" " /><Run Text="+" />
                                    <Run Text="{Binding TotalPrivateAmount, Mode=OneWay}" />
                                </TextBlock>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="130" SortMemberPath="TotalUsedAmount">
                    <DataGridTemplateColumn.Header>
                        <controls:NumericFilterColumnHeader
                            x:Name="TotalUsedAmountFilterColumn"
                            Header="Zużyto"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock Text="{Binding TotalUsedAmount}" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{Binding Unit}" Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" SortMemberPath="Description">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="DescriptionFilterColumn"
                            Header="Opis"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto" MinWidth="72"
                                        controls:ConfigurableDataGrid.ColumnKey="Actions">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Akcje"
                                   FontWeight="Bold"
                                   Margin="5,0" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <controls:EditButton Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}"
                                                     ToolTip="Edytuj pakunek"
                                                     Margin="1,0" />
                                <controls:DeleteButton Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Usuń pakunek"
                                                       Margin="1,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </controls:ConfigurableDataGrid>

        <!-- Pagination -->
        <controls:PaginationControl x:Name="Pagination"
                                    Grid.Row="2"
                                    Layout="SingleLine"
                                    PageLoader="{Binding PageLoader}"
                                    InitialPageSize="20"
                                    HorizontalAlignment="Right"
                                    PaginationHorizontalAlignment="Right"
                                    Margin="0,5,0,0" />

        <!-- Create Packing Material Popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsCreatePopupOpen}"
                                 Title="{Binding CreatePackingMaterialViewModel.Title}"
                                 StaysOpen="True">
            <controls:InventoryItemEditor DataContext="{Binding CreatePackingMaterialViewModel}" />
        </controls:PopupWindowHost>
        <controls:PopupWindowHost IsOpen="{Binding IsEditPopupOpen}"
                                  Title="{Binding EditPackingMaterialViewModel.Title}"
                                  StaysOpen="True">
            <controls:InventoryItemEditor DataContext="{Binding EditPackingMaterialViewModel}" />
        </controls:PopupWindowHost>
        <!-- Delete Confirmation Popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsDeletePopupOpen}"
                                 Title="Usuń pakunek"
                                 StaysOpen="True">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,20"
                           TextWrapping="Wrap">
                    <Run Text="Czy na pewno chcesz usunąć pakunek" />
                    <Run Text="{Binding MaterialToDelete.Name, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="?" />
                </TextBlock>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Anuluj"
                            Command="{Binding CancelDeleteCommand}"
                            Margin="0,0,10,0"
                            Padding="15,5" />
                    <Button Content="Usuń"
                            Command="{Binding ConfirmDeleteCommand}"
                            Padding="15,5"
                            Background="{DynamicResource DangerBrush}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:PopupWindowHost>
    </Grid>
</UserControl>
