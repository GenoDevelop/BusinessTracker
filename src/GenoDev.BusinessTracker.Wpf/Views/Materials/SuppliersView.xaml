<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Materials.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:SuppliersViewModel}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Style="{StaticResource GlassToolbarBorderStyle}" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Dostawcy"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,20,0" />
            <controls:CreateButton Command="{Binding CreateSupplierCommand}"
                                   ToolTip="Dodaj dostawcę"
                                   Margin="0,0,2,0" />
            <controls:RefreshButton Click="RefreshButton_Click"
                                    Margin="0,0,2,0" />
            <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Click="FilterToggleButton_Click" />
        </StackPanel>
        </Border>
        
        <!-- Suppliers -->
        <controls:ConfigurableDataGrid x:Name="SuppliersDataGrid"
                  Grid.Row="1"
                  LayoutKey="Materials.SuppliersGrid"
                  ItemsSource="{Binding Suppliers}"
                  SelectedItem="{Binding SelectedSupplier}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  ColumnVisibilityChanged="SuppliersDataGrid_ColumnVisibilityChanged"
                  Sorting="SuppliersDataGrid_Sorting">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"
                                    Visibility="Collapsed" CanUserSort="False"
                                    controls:ConfigurableDataGrid.ColumnKey="Id"
                                    ElementStyle="{StaticResource TechnicalIdDataGridCellTextStyle}"
                                    HeaderTemplate="{StaticResource TechnicalIdDataGridHeaderTemplate}"
                                    controls:ConfigurableDataGrid.ColumnTitle="ID" />
                <DataGridTemplateColumn Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="NameFilterColumn"
                            Header="Nazwa"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="SupplierFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
        
                <DataGridTemplateColumn Width="120" SortMemberPath="Nip">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="NipFilterColumn"
                            Header="NIP"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="SupplierFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Nip}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
        
                <DataGridTemplateColumn Width="2*" SortMemberPath="Description">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="DescriptionFilterColumn"
                            Header="Opis"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="SupplierFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
        
                <DataGridTemplateColumn Width="100" CanUserSort="False"
                                        controls:ConfigurableDataGrid.ColumnKey="Actions">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Akcje" FontWeight="Bold" Margin="5,0" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <controls:WebsiteButton WebsiteUrl="{Binding WebsiteUrl}"
                                                        Margin="1,0" />
                                <controls:EditButton
                                    Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Edytuj dostawcę"
                                    Margin="1,0" />
                                <controls:DeleteButton
                                    Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Usuń dostawcę"
                                    Margin="1,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </controls:ConfigurableDataGrid>
        
        <!-- Pagination -->
        <controls:PaginationControl x:Name="SuppliersPagination"
                                    Grid.Row="2"
                                    Layout="SingleLine"
                                    PageLoader="{Binding SuppliersPageLoader}"
                                    InitialPageSize="20"
                                    HorizontalAlignment="Right"
                                    PaginationHorizontalAlignment="Right"
                                    Margin="0,5,0,0" />
        
        <!-- Create/Edit popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsCreatePopupOpen}"
                                 Title="{Binding CreateSupplierViewModel.Title}"
                                 StaysOpen="True">
            <controls:SupplierEditor DataContext="{Binding CreateSupplierViewModel}" />
        </controls:PopupWindowHost>
        <controls:PopupWindowHost IsOpen="{Binding IsEditPopupOpen}"
                                  Title="{Binding EditSupplierViewModel.Title}"
                                  StaysOpen="True">
            <controls:SupplierEditor DataContext="{Binding EditSupplierViewModel}" />
        </controls:PopupWindowHost>
        
        <!-- Delete confirmation -->
        <controls:PopupWindowHost IsOpen="{Binding IsDeletePopupOpen}"
                                 Title="Usuń dostawcę"
                                 StaysOpen="True">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                    <Run Text="Czy na pewno chcesz usunąć dostawcę " />
                    <Run Text="{Binding SupplierToDelete.Name, Mode=OneWay}"
                         FontWeight="Bold" />
                    <Run Text="?" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj"
                            Command="{Binding CancelDeleteCommand}"
                            Margin="0,0,10,0"
                            Padding="15,5" />
                    <Button Content="Usuń"
                            Command="{Binding ConfirmDeleteCommand}"
                            Padding="15,5"
                            Background="{DynamicResource DangerBrush}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:PopupWindowHost>
    </Grid>
</UserControl>
