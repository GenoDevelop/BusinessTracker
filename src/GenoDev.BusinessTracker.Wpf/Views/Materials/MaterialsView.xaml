<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Materials.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Materials"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:MaterialsViewModel}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:MaterialListViewModel}">
            <local:MaterialListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PackingMaterialListViewModel}">
            <local:PackingMaterialListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FixedAssetListViewModel}">
            <local:FixedAssetListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <local:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliesViewModel}">
            <local:SuppliesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockAdjustmentsViewModel}">
            <local:StockAdjustmentsView />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <TabControl TabStripPlacement="Left"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource SideNavigationTabControlStyle}">
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource MaterialsNavigationGeometry}"
                                                   Text="Materiały" />
                </TabItem.Header>
                <ContentControl Content="{Binding MaterialListViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource PackageNavigationGeometry}"
                                                   Text="Pakunki" />
                </TabItem.Header>
                <ContentControl Content="{Binding PackingMaterialListViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource AssetsNavigationGeometry}"
                                                   Text="Środki&#x0a;trwałe" />
                </TabItem.Header>
                <ContentControl Content="{Binding FixedAssetListViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource SuppliersNavigationGeometry}"
                                                   Text="Dostawcy" />
                </TabItem.Header>
                <ContentControl Content="{Binding SuppliersViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource DeliveriesNavigationGeometry}"
                                                   Text="Dostawy" />
                </TabItem.Header>
                <ContentControl Content="{Binding SuppliesViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource AdjustmentsNavigationGeometry}"
                                                   Text="Korekty&#x0a;stanu" />
                </TabItem.Header>
                <ContentControl Content="{Binding StockAdjustmentsViewModel}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
