<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Materials.FixedAssetListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:FixedAssetListViewModel}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Style="{StaticResource GlassToolbarBorderStyle}" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Środki trwałe"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,20,0" />
            <controls:CreateButton Command="{Binding CreateCommand}"
                                   ToolTip="Dodaj środek trwały"
                                   Margin="0,0,2,0" />
            <controls:RefreshButton Click="RefreshButton_Click"
                                    Margin="0,0,2,0" />
            <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Click="FilterToggleButton_Click" />
        </StackPanel>
        </Border>

        <!-- Fixed Assets Table -->
        <controls:ConfigurableDataGrid x:Name="FixedAssetsDataGrid"
                  Grid.Row="1"
                  LayoutKey="Materials.FixedAssetsGrid"
                  ItemsSource="{Binding FixedAssets}"
                  SelectedItem="{Binding SelectedFixedAsset}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  ColumnVisibilityChanged="DataGrid_ColumnVisibilityChanged"
                  Sorting="DataGrid_Sorting">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="NameFilterColumn"
                            Header="Nazwa"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="120" SortMemberPath="Ean">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="EanFilterColumn"
                            Header="EAN"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Ean}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="150" SortMemberPath="ManufacturerCode">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="ManufacturerCodeFilterColumn"
                            Header="Kod producenta"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ManufacturerCode}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="150" SortMemberPath="Amount">
                    <DataGridTemplateColumn.Header>
                        <controls:NumericFilterColumnHeader
                            x:Name="AmountFilterColumn"
                            Header="Ilość"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Margin="5,0">
                                <Run Text="{Binding TotalCompanyAmount, Mode=OneWay}" /><TextBlock Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                </TextBlock><TextBlock Visibility="{Binding TotalPrivateAmount, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center">
                                    <Run Text=" " /><Run Text="+" />
                                    <Run Text="{Binding TotalPrivateAmount, Mode=OneWay}" />
                                </TextBlock>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" SortMemberPath="Description">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="DescriptionFilterColumn"
                            Header="Opis"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto" MinWidth="72"
                                        controls:ConfigurableDataGrid.ColumnKey="Actions">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Akcje"
                                   FontWeight="Bold"
                                   Margin="5,0" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <controls:EditButton Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}"
                                                     ToolTip="Edytuj środek trwały"
                                                     Margin="1,0" />
                                <controls:DeleteButton Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Usuń środek trwały"
                                                       Margin="1,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </controls:ConfigurableDataGrid>

        <!-- Pagination -->
        <controls:PaginationControl x:Name="Pagination"
                                    Grid.Row="2"
                                    Layout="SingleLine"
                                    PageLoader="{Binding PageLoader}"
                                    InitialPageSize="20"
                                    HorizontalAlignment="Right"
                                    PaginationHorizontalAlignment="Right"
                                    Margin="0,5,0,0" />

        <!-- Create Fixed Asset Popup -->
        <controls:DraggablePopup IsOpen="{Binding IsCreatePopupOpen}"
                                 Title="{Binding CreateFixedAssetViewModel.Title}"
                                 StaysOpen="True">
            <StackPanel Width="500" DataContext="{Binding CreateFixedAssetViewModel}">
                <TextBlock Text="Nazwa (wymagane):" Margin="0,0,0,5" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="EAN:" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Ean, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Kod producenta:" Margin="0,0,0,5" />
                        <TextBox Text="{Binding ManufacturerCode, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Jednostka:" Margin="0,0,0,5" />
                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <TextBlock Text="Opis:" Margin="0,0,0,5" />
                <controls:ResizableTextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         MinHeight="80"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Anuluj"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,10,0"
                            Padding="15,5" />
                    <Button Content="Zapisz"
                            Command="{Binding SaveCommand}"
                            Padding="15,5"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource OnAccentBrush}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:DraggablePopup>
        <!-- Delete Confirmation Popup -->
        <controls:DraggablePopup IsOpen="{Binding IsDeletePopupOpen}"
                                 Title="Potwierdź usunięcie"
                                 StaysOpen="True">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,20"
                           TextWrapping="Wrap">
                    <Run Text="Czy na pewno chcesz usunąć środek trwały" />
                    <Run Text="{Binding AssetToDelete.Name, Mode=OneWay}" FontWeight="Bold" /><Run Text="?" />
                </TextBlock>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Anuluj"
                            Command="{Binding CancelDeleteCommand}"
                            Margin="0,0,10,0"
                            Padding="15,5" />
                    <Button Content="Usuń"
                            Command="{Binding ConfirmDeleteCommand}"
                            Padding="15,5"
                            Background="{DynamicResource DangerBrush}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:DraggablePopup>
    </Grid>
</UserControl>
