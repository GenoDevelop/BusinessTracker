<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Materials.FixedAssetListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:FixedAssetListViewModel}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Środki trwałe"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0" />
            <controls:CreateButton Command="{Binding CreateCommand}"
                                   ToolTip="Dodaj środek trwały"
                                   Margin="0,0,5,0" />
            <controls:RefreshButton Click="RefreshButton_Click"
                                    Margin="0,0,5,0" />
            <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible}"
                                         Click="FilterToggleButton_Click" />
        </StackPanel>

        <!-- Fixed Assets Table -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FixedAssets}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  Sorting="DataGrid_Sorting">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="NameFilterColumn"
                            Header="Nazwa"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="120" SortMemberPath="Ean">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="EanFilterColumn"
                            Header="EAN"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Ean}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="150" SortMemberPath="ManufacturerCode">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="ManufacturerCodeFilterColumn"
                            Header="Kod producenta"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ManufacturerCode}"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="150" SortMemberPath="Amount">
                    <DataGridTemplateColumn.Header>
                        <controls:NumericFilterColumnHeader
                            x:Name="AmountFilterColumn"
                            Header="Ilość"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Margin="5,0">
                                <Run Text="{Binding TotalCompanyAmount, Mode=OneWay}" /><TextBlock Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                </TextBlock><TextBlock Visibility="{Binding TotalPrivateAmount, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Foreground="Gray" FontSize="12" VerticalAlignment="Center">
                                    <Run Text=" " /><Run Text="+" />
                                    <Run Text="{Binding TotalPrivateAmount, Mode=OneWay}" />
                                </TextBlock>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" SortMemberPath="Description">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="DescriptionFilterColumn"
                            Header="Opis"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="Filter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="5,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Akcje"
                                   FontWeight="Bold"
                                   Margin="5,0" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <controls:EditButton Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}"
                                                     ToolTip="Edytuj środek trwały"
                                                     Margin="2,0" />
                                <controls:DeleteButton Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Usuń środek trwały"
                                                       Margin="2,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pagination -->
        <controls:PaginationControl x:Name="Pagination"
                                    Grid.Row="2"
                                    Layout="SingleLine"
                                    PageLoader="{Binding PageLoader}"
                                    InitialPageSize="20"
                                    HorizontalAlignment="Right"
                                    PaginationHorizontalAlignment="Right"
                                    Margin="0,5,0,0" />

        <!-- Create Fixed Asset Popup -->
        <Popup IsOpen="{Binding IsCreatePopupOpen}"
               Placement="Mouse"
               StaysOpen="True">
            <Border Background="White"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="20"
                    Width="500"
                    CornerRadius="5">
                <StackPanel DataContext="{Binding CreateFixedAssetViewModel}">
                    <TextBlock Text="{Binding Title}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15" />

                    <TextBlock Text="Nazwa (wymagane):" Margin="0,0,0,5" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EAN:" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Ean, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kod producenta:" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ManufacturerCode, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Jednostka:" Margin="0,0,0,5" />
                    <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <TextBlock Text="Opis:" Margin="0,0,0,5" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="80"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Anuluj"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,10,0"
                                Padding="15,5" />
                        <Button Content="Zapisz"
                                Command="{Binding SaveCommand}"
                                Padding="15,5"
                                Background="DodgerBlue"
                                Foreground="White"
                                IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <!-- Delete Confirmation Popup -->
        <Popup IsOpen="{Binding IsDeletePopupOpen}"
               Placement="Center"
               StaysOpen="True">
            <Border Background="White"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="20"
                    Width="400"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Usuń środek trwały"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15" />

                    <TextBlock Margin="0,0,0,20"
                               TextWrapping="Wrap">
                        <Run Text="Czy na pewno chcesz usunąć środek trwały " />
                        <Run Text="{Binding AssetToDelete.Name, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="?" />
                    </TextBlock>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Anuluj"
                                Command="{Binding CancelDeleteCommand}"
                                Margin="0,0,10,0"
                                Padding="15,5" />
                        <Button Content="Usuń"
                                Command="{Binding ConfirmDeleteCommand}"
                                Padding="15,5"
                                Background="Red"
                                Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
