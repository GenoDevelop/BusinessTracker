<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Materials.SuppliesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Materials"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             xmlns:enums="clr-namespace:GenoDev.BusinessTracker.Domain.Enums;assembly=GenoDev.BusinessTracker.Domain"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:SuppliesViewModel}">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid x:Name="LayoutGrid"
              SizeChanged="LayoutGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SuppliesColumn"
                                  Width="200"
                                  MinWidth="0"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0" Margin="10, 10, 0, 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Dostawy" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,10,0" />
        
                <controls:CreateButton Command="{Binding CreateSupplyCommand}" ToolTip="Dodaj dostawę" Margin="0,0,5,0" />
                <controls:RefreshButton Click="SuppliesRefreshButton_Click" Margin="0,0,5,0" />
                <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        
            <!-- Date Range Picker -->
            <Grid Grid.Row="1" Margin="0,0,0,5" Visibility="{Binding IsFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:DateRangePicker StartDate="{Binding StartDate}" EndDate="{Binding EndDate}" />
            </Grid>
        
            <!-- Supplies List -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Supplies}"
                     SelectedItem="{Binding SelectedSupply}"
                     SelectionChanged="SuppliesList_SelectionChanged"
                     Margin="0,0,0,3"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="5,4" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name, StringFormat='dd.MM.yyyy'}" FontWeight="Bold" Margin="0,3,0,3" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <ContentPresenter />
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding SupplierName}" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalNetPrice, StringFormat='{}{0:N2}zł'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding TotalGrossPrice, StringFormat='{}{0:N2}zł'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        
            <!-- Create Supply Popup -->
            <controls:DraggablePopup IsOpen="{Binding IsCreatePopupOpen}" Title="Dodaj dostawę" StaysOpen="True">
                <StackPanel Width="400" DataContext="{Binding CreateSupplyViewModel}">
                    <TextBlock Text="Dostawca (wymagane):" Margin="0,0,0,5" />
                    <controls:SearchableComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" SearchPropertyPaths="Nip" Margin="0,0,0,10" />
    
                    <TextBlock Text="Data zamówienia:" Margin="0,0,0,5" />
                    <DatePicker SelectedDate="{Binding OrderDate}" Margin="0,0,0,10" />
    
                    <TextBlock Text="Nr faktury:" Margin="0,0,0,5" />
                    <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cena netto dostawy:" Margin="0,0,0,5" />
                            <controls:NumericTextBox Value="{Binding ShippingNetPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cena brutto dostawy:" Margin="0,0,0,5" />
                            <controls:NumericTextBox Value="{Binding ShippingGrossPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Opis:" Margin="0,0,0,5" />
                    <controls:ResizableTextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Height="100" Margin="0,0,0,20" />
    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="15,5" />
                        <Button Content="Zapisz" Command="{Binding SaveCommand}" Padding="15,5" Background="{DynamicResource AccentBrush}" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </controls:DraggablePopup>
        
            <!-- Edit Supply Popup -->
            <controls:DraggablePopup IsOpen="{Binding IsEditPopupOpen}" Title="Edytuj dostawę" StaysOpen="True">
                <StackPanel Width="400" DataContext="{Binding EditSupplyViewModel}">
                    <TextBlock Text="Dostawca" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <controls:SearchableComboBox ItemsSource="{Binding Suppliers}"
                                              SelectedItem="{Binding SelectedSupplier}"
                                              DisplayMemberPath="Name"
                                              SearchPropertyPaths="Nip"
                                              Margin="0,0,0,15" />
    
                    <TextBlock Text="Data zamówienia" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <DatePicker SelectedDate="{Binding OrderDate}" Margin="0,0,0,15" />
    
                    <TextBlock Text="Status" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding AvailableStatuses}"
                              SelectedItem="{Binding Status}"
                              Margin="0,0,0,15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0"
                                             Fill="{Binding Converter={StaticResource StatusToColorConverter}}" />
                                    <TextBlock Text="{Binding Converter={StaticResource MaterialSupplyStatusToTextConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
    
                    <TextBlock Text="Nr faktury" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" />

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cena netto dostawy" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <controls:NumericTextBox Value="{Binding ShippingNetPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cena brutto dostawy" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <controls:NumericTextBox Value="{Binding ShippingGrossPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Opis" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <controls:ResizableTextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             Height="80"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Margin="0,0,0,20" />
    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Command="{Binding CancelCommand}" Width="80" Margin="0,0,10,0" />
                        <Button Content="Zapisz" Command="{Binding SaveCommand}" Width="80" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </controls:DraggablePopup>
        
            <!-- Add Supply Item Popup -->
            <controls:DraggablePopup IsOpen="{Binding IsAddMaterialPopupOpen}" Title="Dodaj pozycję do dostawy" StaysOpen="True">
                <StackPanel Width="400" DataContext="{Binding AddSupplyItemViewModel}">
                    <TextBlock Text="Typ (wymagane):" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}" Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource SupplyItemTypeToTextConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Conditional Panels for Item Selection -->
                    <StackPanel Visibility="{Binding SelectedType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=MaterialVariant}">
                        <TextBlock Text="Materiał (wymagane):" Margin="0,0,0,5" />
                        <controls:SearchableComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" DisplayMemberPath="Name" Margin="0,0,0,10" />
                        
                        <TextBlock Text="Wariant (wymagane):" Margin="0,0,0,5" />
                        <controls:SearchableComboBox ItemsSource="{Binding MaterialVariants}" SelectedItem="{Binding SelectedMaterialVariant}" DisplayMemberPath="Name" 
                                  SearchPropertyPaths="Ean,ManufacturerCode"
                                  IsEnabled="{Binding SelectedMaterial, Converter={StaticResource NullToBooleanConverter}}" Margin="0,0,0,10" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Packing}">
                        <TextBlock Text="Pakunek (wymagane):" Margin="0,0,0,5" />
                        <controls:SearchableComboBox ItemsSource="{Binding PackingMaterials}" SelectedItem="{Binding SelectedPackingMaterial}" DisplayMemberPath="Name" 
                                  SearchPropertyPaths="Ean,ManufacturerCode"
                                  Margin="0,0,0,10" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=FixedAsset}">
                        <TextBlock Text="Środek trwały (wymagane):" Margin="0,0,0,5" />
                        <controls:SearchableComboBox ItemsSource="{Binding FixedAssets}" SelectedItem="{Binding SelectedFixedAsset}" DisplayMemberPath="Name" 
                                  SearchPropertyPaths="Ean,ManufacturerCode"
                                  Margin="0,0,0,10" />
                    </StackPanel>
    
                    <TextBlock Text="Ilość zestawów:" Margin="0,0,0,5" />
                    <controls:NumericTextBox Value="{Binding SetsAmount, UpdateSourceTrigger=PropertyChanged}" Mode="Integer" Margin="0,0,0,10" />
    
                    <TextBlock Text="Ilość sztuk w zestawie:" Margin="0,0,0,5" />
                    <controls:NumericTextBox Value="{Binding UnitsInSet, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" Margin="0,0,0,10" />
    
                    <TextBlock Text="Cena netto zestawu:" Margin="0,0,0,5" />
                    <controls:NumericTextBox Value="{Binding SetNetPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" Margin="0,0,0,10" />
    
                    <TextBlock Text="Cena brutto zestawu:" Margin="0,0,0,5" />
                    <controls:NumericTextBox Value="{Binding SetGrossPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" Margin="0,0,0,10" />
    
                    <CheckBox Content="Pozycja prywatna" IsChecked="{Binding PrivateSupply}" Margin="0,0,0,20" />
    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="15,5" />
                        <Button Content="Zapisz" Command="{Binding SaveCommand}" Padding="15,5" Background="{DynamicResource AccentBrush}" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </controls:DraggablePopup>
        
            <controls:DraggablePopup IsOpen="{Binding IsDeletePopupOpen}" Title="Potwierdź usunięcie" StaysOpen="True">
                <StackPanel Width="300">
                    <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                        <Run Text="Czy na pewno chcesz usunąć dostawę od " />
                        <Run Text="{Binding SelectedSupply.SupplierName, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" z dnia " />
                        <Run Text="{Binding SelectedSupply.OrderDate, StringFormat='dd.MM.yyyy', Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Command="{Binding CancelDeleteCommand}" Margin="0,0,10,0" Padding="15,5" />
                        <Button Content="Usuń" Command="{Binding ConfirmDeleteCommand}" Padding="15,5" Background="{DynamicResource DangerBrush}" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </controls:DraggablePopup>
        
            <!-- Delete Material Item Popup -->
            <controls:DraggablePopup IsOpen="{Binding IsDeleteItemPopupOpen}" Title="Potwierdź usunięcie" StaysOpen="True">
                <StackPanel Width="300">
                    <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                        <Run Text="Czy na pewno chcesz usunąć materiał " />
                        <Run Text="{Binding SupplyItemToRemove.MaterialName, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" z tej dostawy?" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Command="{Binding CancelDeleteItemCommand}" Margin="0,0,10,0" Padding="15,5" />
                        <Button Content="Usuń" Command="{Binding ConfirmDeleteItemCommand}" Padding="15,5" Background="{DynamicResource DangerBrush}" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </controls:DraggablePopup>
        
            <!-- Edit Supply Item Popup -->
            <controls:DraggablePopup IsOpen="{Binding IsEditItemPopupOpen}" Title="Edytuj pozycję w dostawie" StaysOpen="True">
                <StackPanel Width="400" DataContext="{Binding EditSupplyItemViewModel}">
                    <TextBlock Text="Typ (wymagane):" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}" Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource SupplyItemTypeToTextConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Conditional Panels for Item Selection -->
                    <StackPanel Visibility="{Binding SelectedType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=MaterialVariant}">
                        <TextBlock Text="Materiał (wymagane):" Margin="0,0,0,5" />
                        <controls:SearchableComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" DisplayMemberPath="Name" Margin="0,0,0,10" />
                        
                        <TextBlock Text="Wariant (wymagane):" Margin="0,0,0,5" />
                        <controls:SearchableComboBox ItemsSource="{Binding MaterialVariants}" SelectedItem="{Binding SelectedMaterialVariant}" DisplayMemberPath="Name" 
                                  SearchPropertyPaths="Ean,ManufacturerCode"
                                  IsEnabled="{Binding SelectedMaterial, Converter={StaticResource NullToBooleanConverter}}" Margin="0,0,0,10" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Packing}">
                        <TextBlock Text="Pakunek (wymagane):" Margin="0,0,0,5" />
                        <controls:SearchableComboBox ItemsSource="{Binding PackingMaterials}" SelectedItem="{Binding SelectedPackingMaterial}" DisplayMemberPath="Name" 
                                  SearchPropertyPaths="Ean,ManufacturerCode"
                                  Margin="0,0,0,10" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=FixedAsset}">
                        <TextBlock Text="Środek trwały (wymagane):" Margin="0,0,0,5" />
                        <controls:SearchableComboBox ItemsSource="{Binding FixedAssets}" SelectedItem="{Binding SelectedFixedAsset}" DisplayMemberPath="Name" 
                                  SearchPropertyPaths="Ean,ManufacturerCode"
                                  Margin="0,0,0,10" />
                    </StackPanel>
    
                    <TextBlock Text="Ilość zestawów:" Margin="0,0,0,5" />
                    <controls:NumericTextBox Value="{Binding SetsAmount, UpdateSourceTrigger=PropertyChanged}" Mode="Integer" Margin="0,0,0,10" />
    
                    <TextBlock Text="Ilość sztuk w zestawie:" Margin="0,0,0,5" />
                    <controls:NumericTextBox Value="{Binding UnitsInSet, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" Margin="0,0,0,10" />
    
                    <TextBlock Text="Cena netto zestawu:" Margin="0,0,0,5" />
                    <controls:NumericTextBox Value="{Binding SetNetPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" Margin="0,0,0,10" />
    
                    <TextBlock Text="Cena brutto zestawu:" Margin="0,0,0,5" />
                    <controls:NumericTextBox Value="{Binding SetGrossPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" Margin="0,0,0,10" />
    
                    <CheckBox Content="Pozycja prywatna" IsChecked="{Binding PrivateSupply}" Margin="0,0,0,20" />
    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="15,5" />
                        <Button Content="Zapisz" Command="{Binding SaveCommand}" Padding="15,5" Background="{DynamicResource AccentBrush}" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </controls:DraggablePopup>
        
            <!-- Pagination -->
            <controls:PaginationControl x:Name="SuppliesPagination"
                                        Grid.Row="3"
                                        Layout="CompactTwoRows"
                                        PageLoader="{Binding SuppliesPageLoader}"
                                        InitialPageSize="20"
                                        Margin="0,5,0,0"
                                        FontSize="11" />
        </Grid>
        
        <GridSplitter x:Name="SupplyDetailsSplitter"
                      Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Right"/>
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        
        <!-- Right Panel -->
        <Grid Grid.Column="2"
              Background="{DynamicResource SurfaceAlternativeBrush}"
              IsHitTestVisible="{Binding IsSupplyDetailsLoading, Converter={StaticResource InverseBooleanConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        
            <!-- Upper space: Basic Information -->
            <Grid Grid.Row="0" Margin="10" Visibility="{Binding SelectedSupplyDetails, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
        
                <!-- Header: [OrderDate] Supplier Name and Delete Button -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom">
                            <Run Text="{Binding SelectedSupplyDetails.OrderDate, StringFormat='dd.MM.yyyy'}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedSupplyDetails.SupplierName}" FontWeight="Bold" FontSize="18" Margin="10,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom"/>
                    </StackPanel>
        
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <controls:WebsiteButton
                            Margin="0,0,5,0"
                            WebsiteUrl="{Binding SelectedSupplyDetails.WebsiteUrl}"/>
                        <controls:EditButton Command="{Binding EditSupplyCommand}"
                                             ToolTip="Edytuj dostawę"
                                             Margin="0,0,5,0" />
                        <controls:DeleteButton Command="{Binding DeleteSupplyCommand}"
                                               ToolTip="Usuń dostawę" />
                    </StackPanel>
                </Grid>
        
                <!-- Status, Prices, Invoice Number -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Status:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="60"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,5,0"
                                     Fill="{Binding SelectedSupplyDetails.Status, Converter={StaticResource StatusToColorConverter}}" />
                            <TextBlock Text="{Binding SelectedSupplyDetails.Status, Converter={StaticResource MaterialSupplyStatusToTextConverter}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
        
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Cena:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="60"/>
                        <TextBlock Text="{Binding SelectedSupplyDetails.TotalNetPrice, StringFormat='{}{0:N2} zł'}" FontWeight="SemiBold"/>
                        <TextBlock Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        <TextBlock Text="{Binding SelectedSupplyDetails.TotalGrossPrice, StringFormat='{}{0:N2} zł'}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Dostawa:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="60"/>
                        <TextBlock Text="{Binding SelectedSupplyDetails.ShippingNetPrice, StringFormat='{}{0:N2} zł'}" FontWeight="SemiBold"/>
                        <TextBlock Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        <TextBlock Text="{Binding SelectedSupplyDetails.ShippingGrossPrice, StringFormat='{}{0:N2} zł'}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
        
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Nr faktury:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="60"/>
                        <TextBlock Text="{Binding SelectedSupplyDetails.InvoiceNo}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
        
                <!-- Description -->
                <Grid Grid.Row="1" Grid.Column="1" MinHeight="60">
                    <Border Style="{StaticResource GlassInsetBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding SelectedSupplyDetails.Description}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                          Visibility="{Binding SelectedSupplyDetails, Converter={StaticResource NullToVisibilityConverter}}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
            
            <!-- Bottom Panel: Ordered Materials -->
            <Grid Grid.Row="2" Margin="10, 10, 0, 5" Visibility="{Binding SelectedSupplyDetails, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
        
                <!-- Header for Materials Table -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Zamówione Pozycje" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
        
                    <controls:CreateButton Command="{Binding AddMaterialCommand}" Margin="0,0,5,0" ToolTip="Dodaj pozycję" />
                    <controls:RefreshButton Click="SupplyItemsRefreshButton_Click" Margin="0,0,5,0" />
                    <controls:FilterToggleButton IsChecked="{Binding IsItemsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Click="SupplyItemsFilterToggleButton_Click" />
                </StackPanel>
        
                <!-- Materials DataGrid -->
                <controls:ConfigurableDataGrid x:Name="SupplyItemsDataGrid"
                          Grid.Row="1" LayoutKey="Materials.SupplyItemsGrid"
                          ItemsSource="{Binding SupplyItems}" SelectedItem="{Binding SelectedSupplyItem}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{DynamicResource SurfaceBrush}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          ColumnVisibilityChanged="SupplyItemsDataGrid_ColumnVisibilityChanged"
                          Sorting="SupplyItemsDataGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="1.5*" SortMemberPath="ItemName">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    ToolTip="Nazwa pozycji"
                                    x:Name="ItemNameFilterColumn"
                                    Header="Pozycja"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="0.6*" SortMemberPath="ItemType">
                            <DataGridTemplateColumn.Header>
                                <controls:EnumFilterColumnHeader
                                    x:Name="ItemTypeFilterColumn"
                                    Header="Typ"
                                    EnumType="{x:Type enums:StorageItemType}"
                                    SelectionMode="Multiple"
                                    DisplayNameConverter="{StaticResource SupplyItemTypeToTextConverter}"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemType, Converter={StaticResource SupplyItemTypeToTextConverter}}" 
                                               VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.6*" SortMemberPath="Ean">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    x:Name="EanFilterColumn"
                                    Header="EAN"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Ean}" VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="0.6*" SortMemberPath="ManufacturerCode">
                            <DataGridTemplateColumn.Header>
                                <controls:TextFilterColumnHeader
                                    ToolTip="Kod producenta"
                                    x:Name="ManufacturerCodeFilterColumn"
                                    Header="Kod"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ManufacturerCode}" VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.4*" SortMemberPath="SetsAmount">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="SetsAmountFilterColumn"
                                    Header="Zest."
                                    ToolTip="Ilość zestawów"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SetsAmount}" VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.5*" SortMemberPath="UnitsInSet">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="UnitsInSetFilterColumn"
                                    Header="W Zest."
                                    ToolTip="Ilość sztuk w zestawie"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <TextBlock Text="{Binding UnitsInSet}" VerticalAlignment="Center"/><TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.5*" SortMemberPath="TotalAmount">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="TotalAmountFilterColumn"
                                    Header="Ilość"
                                    ToolTip="Sumaryczna ilość sztuk we wszystkich zestawach"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,0">
                                        <!-- Normal case: PrivateSupply is false -->
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrivateSupply}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding TotalAmount, Mode=OneWay}" /><TextBlock Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                            </TextBlock>
                                        </TextBlock>

                                        <!-- Private supply case: PrivateSupply is true -->
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrivateSupply}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="0" /><TextBlock Visibility="{Binding Unit, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                            </TextBlock><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center">
                                                <Run Text=" "/><Run Text="+" />
                                                <Run Text="{Binding TotalAmount, Mode=OneWay}" />
                                            </TextBlock>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.6*" SortMemberPath="SetNetPrice">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="SetNetPriceFilterColumn"
                                    Header="Z. Netto"
                                    ToolTip="Cena netto za zestaw"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SetNetPrice, StringFormat='{}{0:N2}zł'}" VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.6*" SortMemberPath="SetGrossPrice">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="SetGrossPriceFilterColumn"
                                    Header="Z. Brutto"
                                    ToolTip="Cena brutto za zestaw"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SetGrossPrice, StringFormat='{}{0:N2}zł'}" VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.7*" SortMemberPath="TotalNetPrice">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="TotalNetPriceFilterColumn"
                                    Header="Netto"
                                    ToolTip="Całkowita cena netto za wszystkie zestawy"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalNetPrice, StringFormat='{}{0:N2}zł'}" VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.7*" SortMemberPath="TotalGrossPrice">
                            <DataGridTemplateColumn.Header>
                                <controls:NumericFilterColumnHeader
                                    x:Name="TotalGrossPriceFilterColumn"
                                    Header="Brutto"
                                    ToolTip="Całkowita cena brutto za wszystkie zestawy"
                                    DebounceMilliseconds="500"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalGrossPrice, StringFormat='{}{0:N2}zł'}" VerticalAlignment="Center" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
        
                        <DataGridTemplateColumn Width="0.3*" SortMemberPath="PrivateSupply">
                            <DataGridTemplateColumn.Header>
                                <controls:BooleanFilterColumnHeader
                                    x:Name="PrivateSupplyFilterColumn"
                                    Header="Pryw."
                                    ToolTip="Czy pozycja jest traktowana jako zasób prywatny"
                                    IsNullable="False"
                                    IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    FilterChanged="SupplyItemsFilter_FilterChanged" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrivateSupply, Converter={StaticResource PolishBooleanDisplayConverter}}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto"
                                                controls:ConfigurableDataGrid.ColumnKey="Actions">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Akcje" FontWeight="Bold" Margin="5,0"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <controls:EditButton
                                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Edytuj pozycję"
                                            Margin="2,0"
                                            Width="14" />
                                        <controls:DeleteButton
                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Usuń pozycję"
                                            Margin="2,0"
                                            Width="14" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </controls:ConfigurableDataGrid>
        
                <!-- Pagination for Materials -->
                <controls:PaginationControl x:Name="SupplyItemsPagination"
                                            Grid.Row="2"
                                            Layout="SingleLine"
                                            PageLoader="{Binding SupplyItemsPageLoader}"
                                            InitialPageSize="50"
                                            HorizontalAlignment="Right"
                                            PaginationHorizontalAlignment="Right"
                                            Margin="0,5,0,0" />
            </Grid>
        
            <TextBlock Grid.RowSpan="3" Text="Wybierz dostawę z listy, aby zobaczyć szczegóły"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding SelectedSupplyDetails, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
