<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Sales.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Sales"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             xmlns:converters="clr-namespace:GenoDev.BusinessTracker.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:OrdersViewModel}">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid x:Name="LayoutGrid" SizeChanged="LayoutGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OrdersColumn" Width="200" MinWidth="0"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5, 10, 0, 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Style="{StaticResource MasterListToolbarBorderStyle}" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Zamówienia" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,3,0" />

                        <controls:CreateButton Command="{Binding CreateOrderCommand}" ToolTip="Dodaj zamówienie" Style="{StaticResource MasterListToolbarIconButtonStyle}" />
                        <controls:RefreshButton Click="OrdersRefreshButton_Click" Style="{StaticResource MasterListToolbarIconButtonStyle}" />
                        <controls:FilterToggleButton
                            Style="{StaticResource MasterListToolbarIconToggleButtonStyle}"
                            IsChecked="{Binding IsFilterVisible,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- Date Range Picker -->
                <Grid Grid.Row="1" Margin="0,0,0,5" Visibility="{Binding IsFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:DateRangePicker StartDate="{Binding StartDate}" EndDate="{Binding EndDate}" />
                </Grid>

                <!-- Orders List -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Orders}"
                         SelectedItem="{Binding SelectedOrder}"
                         Margin="0,0,0,3"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="5,4" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, StringFormat='dd.MM.yyyy'}" FontWeight="Bold" Margin="0,3,0,3" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,5,5,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding OrderIdentifier}" FontWeight="Bold" />
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding TotalNetPrice, StringFormat='{}{0:N2}zł'}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text="/" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text="{Binding TotalGrossPrice, StringFormat='{}{0:N2}zł'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding OrderSource}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Pagination -->
                <controls:PaginationControl Grid.Row="3"
                                            Layout="CompactTwoRows"
                                           x:Name="OrdersPagination"
                                           PageLoader="{Binding OrdersPageLoader}"
                                           InitialPageSize="20" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource VerticalPanelGridSplitterStyle}" />

            <!-- Details Panel -->
            <Grid Grid.Column="2" Background="{DynamicResource SurfaceAlternativeBrush}">
                <Grid Margin="5,0,0,3" Visibility="{Binding SelectedOrder, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="5,5,5,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom">
                                <Run Text="{Binding SelectedOrder.OrderDate, StringFormat='dd.MM.yyyy'}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedOrder.OrderIdentifier}" FontWeight="Bold" FontSize="18" Margin="10,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <controls:EditButton Command="{Binding EditOrderCommand}" ToolTip="Edytuj zamówienie" Margin="0,0,2,0" />
                            <controls:DeleteButton Command="{Binding DeleteOrderCommand}" ToolTip="Usuń zamówienie" />
                        </StackPanel>
                    </Grid>

                    <!-- Top Tabs -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0" Margin="0,0,0,10">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="Padding" Value="10,2" />
                            </Style>
                        </TabControl.Resources>
                        <TabItem Header="Szczegóły">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="OrderLabels" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0"
                                                 Fill="{Binding SelectedOrder.Status, Converter={StaticResource StatusToColorConverter}}" />
                                        <TextBlock Text="{Binding SelectedOrder.Status, Converter={StaticResource OrderStatusToPolishConverter}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cena: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Run Text="{Binding SelectedOrder.TotalNetPrice, StringFormat='{}{0:N2} zł'}" />
                                        <Run Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text="{Binding SelectedOrder.TotalGrossPrice, StringFormat='{}{0:N2} zł'}" Foreground="{DynamicResource AccentBrush}"/>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Źródło: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.OrderSource}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4" />
                                </Grid>

                                <Grid Grid.Column="1" Margin="10,0,20,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ShippingLabels" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tracking: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding SelectedOrder.TrackingNumber}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedOrder.Carrier, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedOrder.Carrier, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Hyperlink Command="{Binding DataContext.OpenTrackingUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                       CommandParameter="{Binding SelectedOrder}"
                                                       TextDecorations="Underline" Foreground="{DynamicResource AccentBrush}">
                                                <TextBlock Text="{Binding SelectedOrder.TrackingNumber}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedOrder.Carrier, StringFormat=' ({0})'}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedOrder.Carrier, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Koszt wysyłki: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Run Text="{Binding SelectedOrder.ShippingNetCost, StringFormat='{}{0:N2} zł'}" />
                                        <Run Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text="{Binding SelectedOrder.ShippingGrossCost, StringFormat='{}{0:N2} zł'}" Foreground="{DynamicResource AccentBrush}"/>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Wysyłka klient: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Run Text="{Binding SelectedOrder.ShippingNetClientPrice, StringFormat='{}{0:N2} zł'}" />
                                        <Run Text=" / " Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text="{Binding SelectedOrder.ShippingGrossClientPrice, StringFormat='{}{0:N2} zł'}" Foreground="{DynamicResource AccentBrush}"/>
                                    </TextBlock>
                                </Grid>

                                <Grid Grid.Column="2" Margin="10,0,0,0">
                                    <Border Style="{StaticResource ReadOnlyDescriptionBorderStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding SelectedOrder.Description}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Klient">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Klient: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.ClientDetails.ClientName}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Adres: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Run Text="{Binding SelectedOrder.ClientDetails.Street}" />, 
                                        <Run Text="{Binding SelectedOrder.ClientDetails.PostCode}" /> 
                                        <Run Text="{Binding SelectedOrder.ClientDetails.City}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="E-mail: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.ClientDetails.Email}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Telefon: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOrder.ClientDetails.Phone}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Firma: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedOrder.CompanyOrder, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='Tak;Nie'}" 
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource ReadOnlyDescriptionBorderStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding SelectedOrder.ClientDetails.Description}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="Transparent">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Bottom Tabs (Products/Materials) -->
                    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0,1,0,0" Margin="0,5,0,0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="Padding" Value="10,2" />
                            </Style>
                        </TabControl.Resources>
                        
                        <TabItem Header="Produkty">
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Zamówione Produkty" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <controls:CreateButton Command="{Binding AddProductCommand}" ToolTip="Dodaj produkt do zamówienia" Margin="0,0,2,0" />
                                    <controls:RefreshButton Click="ProductsRefreshButton_Click" Margin="0,0,2,0" />
                                    <controls:FilterToggleButton
                                        IsChecked="{Binding IsProductsFilterVisible,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <controls:ConfigurableDataGrid x:Name="OrderProductsDataGrid"
                                          Grid.Row="1" LayoutKey="Sales.OrderProductsGrid"
                                          ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedOrderProduct}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="{DynamicResource SurfaceBrush}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                          ColumnVisibilityChanged="OrderProductsDataGrid_ColumnVisibilityChanged"
                                          Sorting="ProductsDataGrid_Sorting">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="2*" SortMemberPath="ProductName">
                                            <DataGridTemplateColumn.Header>
                                                <controls:TextFilterColumnHeader x:Name="ProductNameFilterColumn" Header="Produkt"
                                                    FilterChanged="ProductsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" Margin="5,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="1*" SortMemberPath="Identifier">
                                            <DataGridTemplateColumn.Header>
                                                <controls:TextFilterColumnHeader x:Name="ProductIdentifierFilterColumn" Header="Identyfikator"
                                                   
                                                    FilterChanged="ProductsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Identifier}" VerticalAlignment="Center" Margin="5,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="0.6*" SortMemberPath="OrderedAmount">
                                            <DataGridTemplateColumn.Header>
                                                <controls:NumericFilterColumnHeader x:Name="OrderedAmountFilterColumn" Header="Zamówiono"
                                                   
                                                    FilterChanged="ProductsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OrderedAmount}" VerticalAlignment="Center" Margin="5,0" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="0.6*" SortMemberPath="AssignedAmount">
                                            <DataGridTemplateColumn.Header>
                                                <controls:NumericFilterColumnHeader x:Name="AssignedAmountFilterColumn" Header="Przypisano"
                                                   
                                                    FilterChanged="ProductsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AssignedAmount}" VerticalAlignment="Center" Margin="5,0" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="0.8*" SortMemberPath="UnitNetPrice">
                                            <DataGridTemplateColumn.Header>
                                                <controls:NumericFilterColumnHeader x:Name="UnitNetPriceFilterColumn" Header="Cena Netto"
                                                   
                                                    FilterChanged="ProductsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding UnitNetPrice, StringFormat='{}{0:N2} zł'}" VerticalAlignment="Center" Margin="5,0" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="0.8*" SortMemberPath="UnitGrossPrice">
                                            <DataGridTemplateColumn.Header>
                                                <controls:NumericFilterColumnHeader x:Name="UnitGrossPriceFilterColumn" Header="Cena Brutto"
                                                   
                                                    FilterChanged="ProductsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding UnitGrossPrice, StringFormat='{}{0:N2} zł'}" VerticalAlignment="Center" Margin="5,0" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="0.8*" SortMemberPath="TotalNetPrice">
                                            <DataGridTemplateColumn.Header>
                                                <controls:NumericFilterColumnHeader x:Name="TotalNetPriceFilterColumn" Header="Suma Netto"
                                                   
                                                    FilterChanged="ProductsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TotalNetPrice, StringFormat='{}{0:N2} zł'}" VerticalAlignment="Center" Margin="5,0" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="0.8*" SortMemberPath="TotalGrossPrice">
                                            <DataGridTemplateColumn.Header>
                                                <controls:NumericFilterColumnHeader x:Name="TotalGrossPriceFilterColumn" Header="Suma Brutto"
                                                   
                                                    FilterChanged="ProductsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TotalGrossPrice, StringFormat='{}{0:N2} zł'}" VerticalAlignment="Center" Margin="5,0" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="Auto" MinWidth="102"
                                                                controls:ConfigurableDataGrid.ColumnKey="Actions">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Akcje" FontWeight="Bold" Margin="5,0"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <controls:PhotosButton Command="{Binding DataContext.OpenProductImagesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                               CommandParameter="{Binding}"
                                                                               Margin="1,0" />
                                                        <controls:EditButton Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                             CommandParameter="{Binding}"
                                                                             Margin="1,0" />
                                                        <controls:DeleteButton Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                               CommandParameter="{Binding}"
                                                                               Margin="1,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </controls:ConfigurableDataGrid>

                                <controls:PaginationControl Grid.Row="2" Margin="0,5,0,0" x:Name="ProductsPagination" Layout="SingleLine"
                                    PageLoader="{Binding ProductsPageLoader}" InitialPageSize="50" HorizontalAlignment="Right" />
                            </Grid>
                        </TabItem>
                        
                        <TabItem Header="Materiały do pakowania">
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Materiały do Pakowania" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <controls:CreateButton Command="{Binding AddPackingMaterialCommand}" ToolTip="Dodaj materiał opakowaniowy" Margin="0,0,2,0" />
                                    <controls:RefreshButton Click="PackingMaterialsRefreshButton_Click" Margin="0,0,2,0" />
                                    <controls:FilterToggleButton
                                        IsChecked="{Binding IsPackingMaterialsFilterVisible,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <controls:ConfigurableDataGrid x:Name="OrderPackingMaterialsDataGrid"
                                          Grid.Row="1" LayoutKey="Sales.OrderPackingMaterialsGrid"
                                          ItemsSource="{Binding PackingMaterials}" SelectedItem="{Binding SelectedOrderPackingMaterial}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="{DynamicResource SurfaceBrush}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                          ColumnVisibilityChanged="OrderPackingMaterialsDataGrid_ColumnVisibilityChanged"
                                          Sorting="PackingMaterialsDataGrid_Sorting">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="2*" SortMemberPath="Name">
                                            <DataGridTemplateColumn.Header>
                                                <controls:TextFilterColumnHeader x:Name="PackingMaterialNameFilterColumn" Header="Nazwa"
                                                   
                                                    FilterChanged="PackingMaterialsFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="1*" SortMemberPath="Ean">
                                            <DataGridTemplateColumn.Header>
