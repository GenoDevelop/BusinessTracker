                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="15,5" />
                        <Button Content="Zapisz" Command="{Binding SaveCommand}" Padding="15,5" Background="{DynamicResource AccentBrush}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </controls:PopupWindowHost>

        <controls:PopupWindowHost IsOpen="{Binding IsEditOrderProductFormOpen}" Title="{Binding EditOrderProductFormViewModel.Title}" StaysOpen="True">
            <Grid Width="450" DataContext="{Binding EditOrderProductFormViewModel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                        <TextBlock Text="Produkt" Margin="0,0,0,2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        <controls:SearchableComboBox ItemsSource="{Binding Products}" 
                                                   SelectedItem="{Binding SelectedProduct}"
                                                   DisplayMemberPath="Name"
                                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,10">
                                <TextBlock Text="Ilość zamówiona" Margin="0,0,0,2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <controls:NumericTextBox Value="{Binding OrderedAmount, UpdateSourceTrigger=PropertyChanged}" Mode="Integer" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,10">
                                <TextBlock Text="Ilość przypisana" Margin="0,0,0,2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <controls:NumericTextBox Value="{Binding AssignedAmount, UpdateSourceTrigger=PropertyChanged}" Mode="Integer" />
                                <TextBlock Text="{Binding StockInfo}" Margin="0,2,0,0" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStockExceeded}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,10">
                                <TextBlock Text="Cena jednostkowa netto" Margin="0,0,0,2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <controls:NumericTextBox Value="{Binding UnitNetPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,10">
                                <TextBlock Text="Cena jednostkowa brutto" Margin="0,0,0,2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <controls:NumericTextBox Value="{Binding UnitGrossPrice, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="15,5" />
                        <Button Content="Zapisz" Command="{Binding SaveCommand}" Padding="15,5" Background="{DynamicResource AccentBrush}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </controls:PopupWindowHost>

        <controls:PopupWindowHost IsOpen="{Binding IsOrderProductDeleteConfirmationOpen}" Title="Usuń produkt z zamówienia" StaysOpen="True">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                    <Run Text="Czy na pewno chcesz usunąć produkt " />
                    <Run Text="{Binding OrderProductToDelete.ProductName, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text=" z tego zamówienia?" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Command="{Binding CancelDeleteProductCommand}" Margin="0,0,10,0" Padding="15,5" />
                    <Button Content="Usuń" Command="{Binding ConfirmDeleteProductCommand}" Padding="15,5" Background="{DynamicResource DangerBrush}" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:PopupWindowHost>

