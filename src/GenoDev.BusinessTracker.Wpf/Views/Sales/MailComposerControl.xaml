<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Sales.MailComposerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             MinWidth="1000" MinHeight="650">
    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ComposerLeftLabel"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="ComposerRightLabel"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <TextBlock Text="Do:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding RecipientAddress, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="Konto:" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Name"/>
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ComposerLeftLabel"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="ComposerRightLabel"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <TextBlock Text="Temat:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="Szablon:" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <Grid Grid.Column="3" Visibility="{Binding IsResend, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name"/>
                <Button Grid.Column="1" Content="Zastosuj" Command="{Binding ApplySelectedTemplateCommand}" Margin="5,0,0,0"/>
            </Grid>
            <TextBlock Grid.Column="3" Text="{Binding TemplateDisplayName}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsResend, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="0" ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,5">
                <TextBlock Text="HTML" FontWeight="Bold" Margin="0,0,0,4"/>
                <controls:MailImageInsertControl Editor="{Binding ElementName=HtmlBodyEditor}"/>
            </StackPanel>
            <controls:MailHtmlEditor x:Name="HtmlBodyEditor" Grid.Row="1" Html="{Binding HtmlBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
        <controls:RatioGridSplitter Grid.Row="2" Grid.Column="1" Orientation="Vertical"/>
        <Grid Grid.Row="2" Grid.Column="2" ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Podgląd" FontWeight="Bold" Margin="0,0,0,5"/>
            <controls:HtmlPreview Grid.Row="1" Html="{Binding HtmlBody}"/>
        </Grid>
        <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Załączniki" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Dodaj pliki" Command="{Binding AddAttachmentsCommand}" Padding="10,4"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,7,0,0">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MailAttachmentCard Margin="0,0,7,5"
                                    IsDownloadAvailable="True"
                                    DownloadCommand="{Binding DataContext.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    RemoveCommand="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Differences}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MailAttachmentCard Margin="0,0,7,5" IsWarning="True" Description="{Binding Message}"
                                    IsDownloadAvailable="{Binding CanDownload}"
                                    IsAcceptAvailable="{Binding CanAccept}"
                                    IsReplaceAvailable="{Binding CanReplace}"
                                    DownloadCommand="{Binding DataContext.DownloadDifferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AcceptCommand="{Binding DataContext.AcceptDifferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    RemoveCommand="{Binding DataContext.RemoveDifferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ReplaceCommand="{Binding DataContext.ReplaceDifferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="{Binding AttachmentErrorMessage}" Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" Margin="0,5,0,0"
                       Visibility="{Binding AttachmentErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </Grid>
        <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Załączniki wymagają decyzji — zaakceptuj, usuń albo podmień plik"
                       Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       Visibility="{Binding HasDifferences, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Anuluj" Command="{Binding CloseCommand}" Margin="0,0,8,0" Padding="14,5"/>
                <Button Content="Dodaj do kolejki" Command="{Binding SendCommand}" IsDefault="True" Padding="14,5" Background="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
