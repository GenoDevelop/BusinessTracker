<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Sales.OrdersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Sales"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:OrdersViewModel}">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid x:Name="LayoutGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OrdersColumn"
                                  Width="250"
                                  MinWidth="0"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>
        
            <!-- Left Panel: Orders List -->
            <Grid Grid.Column="0" Margin="10, 10, 0, 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            
                <!-- Toolbar -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Zamówienia" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
            
                    <controls:CreateButton ToolTip="Dodaj zamówienie" Margin="0,0,5,0" />
                    <controls:RefreshButton Margin="0,0,5,0" />
                    <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible}" />
                </StackPanel>
            
                <!-- Date Range Picker (Placeholder Filter) -->
                <Grid Grid.Row="1" Margin="0,0,0,5" Visibility="{Binding IsFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:DateRangePicker />
                </Grid>
            
                <!-- Orders List -->
                <ListBox Grid.Row="2"
                         Margin="0,0,0,3"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E0EEFF" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F7FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="Order #12345" FontWeight="Bold" />
                                <TextBlock Text="Klient: Jan Kowalski" FontSize="11" Foreground="Gray" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            
                <!-- Pagination -->
                <controls:PaginationControl Grid.Row="3"
                                            Layout="CompactTwoRows"
                                            InitialPageSize="20"
                                            Margin="0,5,0,0"
                                            FontSize="11" />
            </Grid>
            
            <GridSplitter x:Name="OrderDetailsSplitter"
                          Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Rectangle Width="1" Fill="#DDD" VerticalAlignment="Stretch" HorizontalAlignment="Right"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
            
            <!-- Right Panel -->
            <Grid Grid.Column="2" Background="#F9F9F9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            
                <!-- Upper space: Basic Information -->
                <Grid Grid.Row="0" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
            
                    <!-- Header -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="31.07.2026" FontSize="18" FontWeight="Bold" Foreground="Gray" VerticalAlignment="Bottom" />
                            <TextBlock Text="Zamówienie #12345" FontWeight="Bold" FontSize="18" Margin="10,0,0,0" Foreground="Black" VerticalAlignment="Bottom"/>
                        </StackPanel>
            
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <controls:EditButton ToolTip="Edytuj zamówienie" Margin="0,0,5,0" />
                            <controls:DeleteButton ToolTip="Usuń zamówienie" />
                        </StackPanel>
                    </Grid>
            
                    <!-- Details -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Klient:" Foreground="Gray" FontSize="11" Width="80"/>
                            <TextBlock Text="Jan Kowalski" FontWeight="SemiBold"/>
                        </StackPanel>
            
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Wartość:" Foreground="Gray" FontSize="11" Width="80"/>
                            <TextBlock Text="100.00 zł" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
            
                    <!-- Description -->
                    <Grid Grid.Row="1" Grid.Column="1" MinHeight="60">
                        <Border BorderBrush="#DDD" BorderThickness="1" Background="White" CornerRadius="3" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="Przykładowy opis zamówienia..." TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Rectangle Height="1" Fill="#DDD" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                
                <!-- Bottom Panel: TabControl with Tables -->
                <Grid Grid.Row="2" Margin="10, 10, 0, 5">
                    <TabControl>
                        <TabItem Header="Produkty">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,5">
                                    <controls:CreateButton Margin="0,0,5,0" ToolTip="Dodaj produkt" />
                                    <controls:RefreshButton Margin="0,0,5,0" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Produkt" Width="*" />
                                        <DataGridTextColumn Header="Ilość" Width="100" />
                                        <DataGridTextColumn Header="Cena" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <controls:PaginationControl Grid.Row="2" Layout="SingleLine" HorizontalAlignment="Right" Margin="0,5,0,0" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Materiały pakowe">
                             <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,5">
                                    <controls:CreateButton Margin="0,0,5,0" ToolTip="Dodaj materiał" />
                                    <controls:RefreshButton Margin="0,0,5,0" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Materiał" Width="*" />
                                        <DataGridTextColumn Header="Ilość" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <controls:PaginationControl Grid.Row="2" Layout="SingleLine" HorizontalAlignment="Right" Margin="0,5,0,0" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>