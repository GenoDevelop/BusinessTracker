<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Production.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             xmlns:production="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Production"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance production:ProductsViewModel}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassToolbarBorderStyle}" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Produkty" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,20,0" />
            <controls:CreateButton Command="{Binding CreateProductCommand}" ToolTip="Dodaj produkt" Margin="0,0,2,0"/>
            <controls:RefreshButton Click="ProductsRefreshButton_Click" Margin="0,0,2,0" />
            <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        </Border>
        
        <controls:ConfigurableDataGrid x:Name="ProductsDataGrid"
                  Grid.Row="1" LayoutKey="Production.ProductsGrid"
                  ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource SurfaceBrush}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  ColumnVisibilityChanged="ProductsDataGrid_ColumnVisibilityChanged"
                  Sorting="DataGrid_Sorting">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"
                                    Visibility="Collapsed" CanUserSort="False"
                                    controls:ConfigurableDataGrid.ColumnKey="Id"
                                    ElementStyle="{StaticResource TechnicalIdDataGridCellTextStyle}"
                                    HeaderTemplate="{StaticResource TechnicalIdDataGridHeaderTemplate}"
                                    controls:ConfigurableDataGrid.ColumnTitle="ID" />
                <DataGridTemplateColumn Width="2*" SortMemberPath="Name">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="NameFilterColumn"
                            Header="Nazwa"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Width="1*" SortMemberPath="Identifier">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="IdentifierFilterColumn"
                            Header="Identyfikator"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Identifier}" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Width="75" SortMemberPath="Amount">
                    <DataGridTemplateColumn.Header>
                        <controls:NumericFilterColumnHeader
                            x:Name="AmountFilterColumn"
                            Header="Stan"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Amount}" VerticalAlignment="Center" Margin="5,0" HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="75" SortMemberPath="TotalSoldAmount">
                    <DataGridTemplateColumn.Header>
                        <controls:NumericFilterColumnHeader
                            x:Name="TotalSoldAmountFilterColumn"
                            Header="Sprzedano"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TotalSoldAmount}" VerticalAlignment="Center" Margin="5,0"
                                       HorizontalAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Width="3*" SortMemberPath="Description">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="DescriptionFilterColumn"
                            Header="Opis"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
        
                <DataGridTemplateColumn Width="110"
                                        controls:ConfigurableDataGrid.ColumnKey="Actions"
                                        controls:ConfigurableDataGrid.ColumnTitle="Akcje">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Akcje" FontWeight="Bold" Margin="5,0" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <controls:PhotosButton
                                    Command="{Binding DataContext.OpenImagesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,2,0" />
                                <controls:EditButton
                                    Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,2,0" />
                                <controls:DeleteButton
                                    Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </controls:ConfigurableDataGrid>
        
        <!-- Pagination -->
        <controls:PaginationControl x:Name="ProductsPagination"
                                    Grid.Row="2"
                                    Layout="SingleLine"
                                    PageLoader="{Binding ProductsPageLoader}"
                                    HorizontalAlignment="Right"
                                    PaginationHorizontalAlignment="Right"
                                    Margin="0,5,0,0" />
        
        <!-- Create Product Popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsCreatePopupOpen}"
                                 Title="{Binding CreateProductViewModel.Title}"
                                 StaysOpen="True">
            <controls:ProductEditor DataContext="{Binding CreateProductViewModel}" />
        </controls:PopupWindowHost>

        <controls:PopupWindowHost IsOpen="{Binding IsEditPopupOpen}"
                                  Title="{Binding EditProductViewModel.Title}"
                                  StaysOpen="True">
            <controls:ProductEditor DataContext="{Binding EditProductViewModel}" />
        </controls:PopupWindowHost>

        <controls:ProductImagesPopup DataContext="{Binding ProductImages}" />
        
        <!-- Delete Product Confirmation Popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsDeletePopupOpen}"
                                 Title="Usuń produkt"
                                 StaysOpen="True">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                    <Run Text="Czy na pewno chcesz usunąć produkt " />
                    <Run Text="{Binding ProductToDelete.Name, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="?" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Command="{Binding CancelDeleteCommand}" Margin="0,0,10,0" Padding="15,5" />
                    <Button Content="Usuń" Command="{Binding ConfirmDeleteCommand}" Padding="15,5" Background="{DynamicResource DangerButtonBackgroundBrush}" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:PopupWindowHost>
    </Grid>
</UserControl>
