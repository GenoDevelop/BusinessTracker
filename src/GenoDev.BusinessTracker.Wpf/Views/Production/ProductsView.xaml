<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Production.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             xmlns:production="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Production"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance production:ProductsViewModel}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Produkty" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" />
            <controls:CreateButton Command="{Binding CreateProductCommand}" ToolTip="Dodaj produkt" Margin="0,0,5,0"/>
            <controls:RefreshButton Click="ProductsRefreshButton_Click" Margin="0,0,5,0" />
            <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        
        <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="White"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  Sorting="DataGrid_Sorting">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="2*" SortMemberPath="Name">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="NameFilterColumn"
                            Header="Nazwa"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Width="1*" SortMemberPath="Identifier">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="IdentifierFilterColumn"
                            Header="Identyfikator"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Identifier}" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Width="75" SortMemberPath="Amount">
                    <DataGridTemplateColumn.Header>
                        <controls:NumericFilterColumnHeader
                            x:Name="AmountFilterColumn"
                            Header="Stan"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Amount}" VerticalAlignment="Center" Margin="5,0" HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="75" SortMemberPath="TotalSoldAmount">
                    <DataGridTemplateColumn.Header>
                        <controls:NumericFilterColumnHeader
                            x:Name="TotalSoldAmountFilterColumn"
                            Header="Sprzedano"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TotalSoldAmount}" VerticalAlignment="Center" Margin="5,0"
                                       HorizontalAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Width="3*" SortMemberPath="Description">
                    <DataGridTemplateColumn.Header>
                        <controls:TextFilterColumnHeader
                            x:Name="DescriptionFilterColumn"
                            Header="Opis"
                            DebounceMilliseconds="500"
                            IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            FilterChanged="ProductsFilter_FilterChanged" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
        
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <controls:EditButton
                                    Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,5,0" />
                                <controls:DeleteButton
                                    Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Pagination -->
        <controls:PaginationControl x:Name="ProductsPagination"
                                    Grid.Row="2"
                                    Layout="SingleLine"
                                    PageLoader="{Binding ProductsPageLoader}"
                                    HorizontalAlignment="Right"
                                    PaginationHorizontalAlignment="Right"
                                    Margin="0,5,0,0" />
        
        <!-- Create Product Popup -->
        <controls:DraggablePopup IsOpen="{Binding IsCreatePopupOpen}"
                                 Title="{Binding CreateProductViewModel.Title}"
                                 StaysOpen="True">
            <StackPanel Width="400" DataContext="{Binding CreateProductViewModel}">
                <TextBlock Text="Nazwa (wymagane):" Margin="0,0,0,5" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
    
                <TextBlock Text="Identyfikator (wymagane):" Margin="0,0,0,5" />
                <TextBox Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
    
                <TextBlock Text="Opis:" Margin="0,0,0,5" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         Height="100" Margin="0,0,0,20" />
    
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="15,5" />
                    <Button Content="Zapisz" Command="{Binding SaveCommand}" Padding="15,5" Background="LightBlue" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:DraggablePopup>
        
        <!-- Delete Product Confirmation Popup -->
        <controls:DraggablePopup IsOpen="{Binding IsDeletePopupOpen}"
                                 Title="Potwierdź usunięcie"
                                 StaysOpen="True">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                    <Run Text="Czy na pewno chcesz usunąć produkt " />
                    <Run Text="{Binding ProductToDelete.Name, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="?" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Command="{Binding CancelDeleteCommand}" Margin="0,0,10,0" Padding="15,5" />
                    <Button Content="Usuń" Command="{Binding ConfirmDeleteCommand}" Padding="15,5" Background="LightCoral" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:DraggablePopup>
    </Grid>
</UserControl>
