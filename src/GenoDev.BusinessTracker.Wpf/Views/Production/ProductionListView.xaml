<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Production.ProductionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Production"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             xmlns:getVariants="clr-namespace:GenoDev.BusinessTracker.ApplicationLogic.UseCases.Materials.GetVariants;assembly=GenoDev.BusinessTracker.ApplicationLogic"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:ProductionListViewModel}">
    <Grid x:Name="LayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="0"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10, 10, 0, 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Style="{StaticResource MasterListToolbarBorderStyle}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Produkcja"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,3,0" />
                    <controls:RefreshButton Click="ProductionsRefreshButton_Click"
                                            Style="{StaticResource MasterListToolbarIconButtonStyle}" />
                    <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MasterListToolbarIconToggleButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Search Header -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10"
                    Visibility="{Binding IsFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SearchIconGeometry}"
                              Style="{StaticResource ToolbarIconStyle}"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                        <TextBox Text="{Binding SearchTerm,
                                                UpdateSourceTrigger=PropertyChanged,
                                                Delay=500,
                                                NotifyOnSourceUpdated=True}"
                                 SourceUpdated="SearchTerm_SourceUpdated"
                                 Width="150"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Products List -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Products}"
                     SelectedItem="{Binding SelectedProduct}"
                     SelectionChanged="ProductsList_SelectionChanged"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="5,4" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                             
                            <!-- Recipes count on the left centered vertically -->
                            <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Width="10">
                                <TextBlock Text="{Binding RecipesCount}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <!-- ProductName (Identifier) -->
                                <TextBlock FontWeight="Bold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <Run Text="{Binding ProductName, Mode=OneWay}" />
                                    <Run Text="(" /><Run Text="{Binding ProductIdentifier, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                                <!-- Stan: [currentAmount/SumOfProduction] -->
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap">
                                    <Run Text="Stan: " /><Run Text="{Binding CurrentAmount, Mode=OneWay}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding HistoricalProductionAmount, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pagination -->
            <controls:PaginationControl x:Name="ProductionsPagination"
                                        Grid.Row="3"
                                        Layout="CompactTwoRows"
                                        PageLoader="{Binding ProductionsPageLoader}"
                                        InitialPageSize="20"
                                        Margin="0,5,0,0"
                                        FontSize="11" />
        </Grid>

        <GridSplitter Grid.Column="1"
                      Style="{StaticResource VerticalPanelGridSplitterStyle}" />

        <!-- Right Panel -->
        <Grid Grid.Column="2" Background="{DynamicResource SurfaceAlternativeBrush}">
            <!-- Empty state -->
            <TextBlock Text="Wybierz produkt z listy, aby zobaczyć szczegóły" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14"
                       Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}" />

            <!-- Details section -->
            <Grid Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Upper space: Basic Information -->
                <Grid Grid.Row="0" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="0"/>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom">
                            <Run Text="{Binding SelectedProduct.ProductName, Mode=OneWay}" />
                            <Run Text="(" /><Run Text="{Binding SelectedProduct.ProductIdentifier, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="Produkt" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ToggleButton IsChecked="{Binding ShowRecipeDetails}"
                                          Style="{StaticResource CompactSwitchToggleButtonStyle}"
                                          ToolTip="Przełącz Produkt/Przepis" />
                            <TextBlock Text="Przepis" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>

                        <!-- Product Details -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <StackPanel Orientation="Vertical" Margin="0,0,0,4">
                                <TextBlock Text="Na stanie:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="100" TextAlignment="Left"/>
                                <TextBlock Text="{Binding SelectedProduct.CurrentAmount}" FontWeight="SemiBold"
                                           TextAlignment="Left" TextWrapping="Wrap" MaxWidth="210"/>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,0,4">
                                <TextBlock Text="Suma produkcji:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="100" TextAlignment="Left"/>
                                <TextBlock Text="{Binding SelectedProduct.HistoricalProductionAmount}" FontWeight="SemiBold"
                                           TextAlignment="Left" TextWrapping="Wrap" MaxWidth="210"/>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,0,4">
                                <TextBlock Text="Przepisy:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="100" TextAlignment="Left" />
                                <TextBlock Text="{Binding SelectedProduct.RecipesCount}" FontWeight="SemiBold"
                                           TextAlignment="Left" TextWrapping="Wrap" MaxWidth="210" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Description -->
                        <Grid Grid.Column="1" MinHeight="100" VerticalAlignment="Stretch">
                            <Border Style="{StaticResource ReadOnlyDescriptionBorderStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding SelectedProduct.Description}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowRecipeDetails}" Value="True">
                                                        <Setter Property="Text" Value="{Binding SelectedRecipe.Description}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <controls:ProductImagesPanel Grid.Column="2"
                                                     DataContext="{Binding ProductImages}"
                                                     Height="170"
                                                     Margin="10,0,0,0" />
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Bottom Section: History and Materials -->
                <Grid Grid.Row="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                     
                    <!-- Shared Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Historia Produkcji" FontSize="16" FontWeight="Bold" Margin="0,0,10,0" />
                            <controls:RefreshButton Click="HistoryRefreshButton_Click"
                                                    Margin="0,0,2,0" />
                            <controls:FilterToggleButton IsChecked="{Binding IsHistoryFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Click="HistoryFilterToggleButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <controls:SearchableComboBox ItemsSource="{Binding ProductRecipes}" 
                                                        SelectedItem="{Binding SelectedRecipe}" 
                                                        DisplayMemberPath="Name"
                                                        Width="200" Margin="0,0,5,0" 
                                                        VerticalAlignment="Center" />
                            <controls:CreateButton Command="{Binding AddProductionCommand}" ToolTip="Dodaj produkcję" />
                        </StackPanel>
                    </Grid>

                    <!-- Content Section: History Table + Materials OR Add Production Form -->
                    <Grid Grid.Row="1">
                        <!-- History and Materials View -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddingProduction}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditingProduction}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="0" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>

                            <!-- Production History Content -->
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,0">
                                <controls:ConfigurableDataGrid x:Name="HistoryDataGrid"
                                          LayoutKey="Production.HistoryGrid"
                                          ItemsSource="{Binding ProductionHistory}"
                                          SelectedItem="{Binding SelectedProduction}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="{DynamicResource SurfaceBrush}"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          ColumnVisibilityChanged="HistoryDataGrid_ColumnVisibilityChanged"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="Auto"
                                                                controls:ConfigurableDataGrid.ColumnKey="Date">
                                            <DataGridTemplateColumn.Header>
                                                <controls:DateRangeFilterColumnHeader
                                                    x:Name="HistoryDateFilterColumn"
                                                    Header="Data"
                                                    IsFilterVisible="{Binding DataContext.IsHistoryFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    MaxFilterWidth="200"
                                                    FilterChanged="HistoryFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProductionDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" VerticalAlignment="Center" Margin="5,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="Auto"
                                                                controls:ConfigurableDataGrid.ColumnKey="Amount">
                                            <DataGridTemplateColumn.Header>
                                                <controls:NumericFilterColumnHeader
                                                    x:Name="HistoryAmountFilterColumn"
                                                    Header="Ilość"
                                                    DebounceMilliseconds="500"
                                                    IsFilterVisible="{Binding DataContext.IsHistoryFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    FilterChanged="HistoryFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProductionAmount}" VerticalAlignment="Center" Margin="5,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="*"
                                                                controls:ConfigurableDataGrid.ColumnKey="Description">
                                            <DataGridTemplateColumn.Header>
                                                <controls:TextFilterColumnHeader
                                                    x:Name="HistoryDescriptionFilterColumn"
                                                    Header="Opis"
                                                    DebounceMilliseconds="500"
                                                    IsFilterVisible="{Binding DataContext.IsHistoryFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    FilterChanged="HistoryFilter_FilterChanged" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="60" Margin="5,0" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                         
                                        <DataGridTemplateColumn Width="Auto" MinWidth="72"
                                                                controls:ConfigurableDataGrid.ColumnKey="Actions">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Akcje"
                                                           FontWeight="Bold"
                                                           Margin="5,0" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <controls:EditButton
                                                            Command="{Binding DataContext.EditProductionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" 
                                                            Margin="0,0,2,0"/>
                                                        <controls:DeleteButton
                                                            Command="{Binding DataContext.DeleteProductionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </controls:ConfigurableDataGrid>
                            </Grid>
                            <!-- Pagination for Production History -->
                            <controls:PaginationControl x:Name="HistoryPagination"
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Layout="SingleLine"
                                                        PageLoader="{Binding HistoryPageLoader}"
                                                        InitialPageSize="20"
                                                        HorizontalAlignment="Right"
                                                        PaginationHorizontalAlignment="Right"
                                                        Margin="0,5,0,0" />

                            <GridSplitter Grid.Column="1"
                                          Grid.Row="0"
                                          Grid.RowSpan="2"
                                          Style="{StaticResource VerticalPanelGridSplitterStyle}" />

                            <!-- Materials List Content -->
                            <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Użyte materiały" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRecipeDetails}" Value="True">
                                                    <Setter Property="Text" Value="Wymagane materiały" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListView Grid.Row="1" ItemsSource="{Binding SelectedMaterials}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=DataContext.ShowRecipeDetails}" Value="False">
                                                    <Setter Property="MinHeight" Value="35" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                 
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MaterialName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding MaterialVariantName}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=DataContext.ShowRecipeDetails}" Value="False" />
                                                                            <Condition Binding="{Binding MaterialVariantName, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                 
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding TotalUsedAmount}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=DataContext.ShowRecipeDetails}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding RequiredAmount}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text=" " />
                                                    <TextBlock Text="{Binding Unit}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>

                        <!-- Add/Edit Production Form -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddingProduction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditingProduction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Dodaj nową produkcję" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingProduction}" Value="True">
                                                    <Setter Property="Text" Value="Edytuj produkcję" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="Ilość produkcji" FontWeight="Bold" Margin="0,0,0,2" />
                                        <controls:NumericTextBox Value="{Binding ProductionAmount, UpdateSourceTrigger=PropertyChanged}" Mode="Integer" Width="100" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                        <TextBlock Text="Data produkcji" FontWeight="Bold" Margin="0,0,0,2" />
                                        <StackPanel Orientation="Horizontal">
                                            <DatePicker SelectedDate="{Binding ProductionDate, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                            <TextBox Text="{Binding ProductionDate, StringFormat='HH:mm', UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5,0,0,0" VerticalContentAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="2" VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Opis" FontWeight="Bold" Margin="0,0,0,2" />
                                        <controls:ResizableTextBox Grid.Row="1" Text="{Binding ProductionDescription, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MaterialInputsWithAdd}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:DynamicMaterialInput}">
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,10" Padding="8" Width="220" CornerRadius="4">
                                                <Grid>
                                                    <Button Command="{Binding RemoveCommand}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Width="26" Height="26"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            Padding="6"
                                                            Margin="0,-5,-5,0"
                                                            ToolTip="Usuń materiał z tej produkcji">
                                                        <Path Data="{StaticResource CloseIconGeometry}"
                                                              Style="{StaticResource ToolbarIconStyle}" />
                                                    </Button>
                                                    
                                                    <StackPanel>
                                                        <TextBlock FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,18,5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="Black" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasEnough}" Value="False">
                                                                            <Setter Property="Foreground" Value="Red" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding MaterialName, Mode=OneWay}" />
                                                            <LineBreak />
                                                            <Run Text="(" FontSize="10" /><Run Text="{Binding TotalRequiredAmount, Mode=OneWay}" FontSize="10" />
                                                            <Run Text=" / " FontSize="10" /><Run Text="{Binding AvailableAmount, Mode=OneWay}" FontSize="10" />
                                                            <Run Text=" " FontSize="10" /><Run Text="{Binding Unit, Mode=OneWay}" FontSize="10" /><Run Text=")" FontSize="10" />
                                                        </TextBlock>
                                                        
                                                        <TextBlock Text="Wariant:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <controls:SearchableComboBox ItemsSource="{Binding Variants}" 
                                                                  SelectedItem="{Binding SelectedVariant}"
                                                                  DisplayMemberPath="Name"
                                                                  SearchPropertyPaths="Ean,ManufacturerCode"
                                                                  Margin="0,0,0,5"/>
    
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <controls:NumericTextBox Grid.Column="0" Value="{Binding UsedAmount, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" />
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding ReloadDefaultCommand}"
                                                                    IsEnabled="{Binding IsModified}"
                                                                    Margin="5,0,0,0"
                                                                    Width="25"
                                                                    ToolTip="Przywróć domyślną wartość">
                                                                <TextBlock Text="⟳" />
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        
                                        <DataTemplate DataType="{x:Type vm:AddMaterialButtonViewModel}">
                                            <Button Command="{Binding Parent.OpenAddMaterialPopupCommand}"
                                                    Margin="0,0,10,10" 
                                                    Width="220" 
                                                    Height="120"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="+" FontSize="40" Foreground="{DynamicResource BorderStrongBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Dodaj materiał" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0">
                                <Button Content="Anuluj"
                                        Command="{Binding CancelAddProductionCommand}"
                                        Margin="0,0,10,0"
                                        Padding="15,5" />
                                <Button Content="Zapisz produkcję"
                                        Command="{Binding SaveProductionCommand}"
                                        Padding="15,5"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Delete History Confirmation Window -->
        <controls:PopupWindowHost IsOpen="{Binding IsDeletePopupOpen}"
                                  Title="Usuń historię produkcji"
                                  StaysOpen="True">
                <StackPanel Width="320">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                        <Run Text="Czy na pewno chcesz usunąć tę historię produkcji z dnia " />
                        <Run Text="{Binding ProductionToDelete.ProductionDate, StringFormat='dd.MM.yyyy HH:mm', Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="?" />
                        <LineBreak />
                        <Run Text="Spowoduje to cofnięcie zmian w stanach magazynowych produktu i materiałów." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Nie" Command="{Binding CancelDeleteProductionCommand}" Margin="0,0,10,0" Padding="15,5"/>
                        <Button Content="Tak" Command="{Binding ConfirmDeleteProductionCommand}" Padding="15,5" Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource OnAccentBrush}" />
                    </StackPanel>
                </StackPanel>
        </controls:PopupWindowHost>

        <!-- Add Material Popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsAddingNewMaterial}" Title="Dodaj nowy materiał" StaysOpen="True">
            <StackPanel Width="350">
                <TextBlock Text="Materiał:" Margin="0,0,0,2" />
                <controls:SearchableComboBox ItemsSource="{Binding AllMaterials}" 
                          SelectedItem="{Binding SelectedMaterialToAdd}" 
                          DisplayMemberPath="Name" 
                          Margin="0,0,0,10" />

                <TextBlock Text="Wariant:" Margin="0,0,0,2" />
                <controls:SearchableComboBox ItemsSource="{Binding NewMaterialVariants}" 
                          SelectedItem="{Binding SelectedVariantToAdd}" 
                          DisplayMemberPath="Name" 
                          SearchPropertyPaths="Ean,ManufacturerCode"
                          Margin="0,0,0,10" />

                <TextBlock Text="Ilość (na jedną sztukę produkcji):" Margin="0,0,0,2" />
                <controls:NumericTextBox Value="{Binding NewMaterialAmount, UpdateSourceTrigger=PropertyChanged}" Mode="Decimal" Margin="0,0,0,15" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Command="{Binding CancelAddNewMaterialCommand}" Margin="0,0,10,0" Padding="15,5" />
                    <Button Content="Dodaj"
                            Command="{Binding ConfirmAddMaterialCommand}"
                            Padding="15,5"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource OnAccentBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" />
                </StackPanel>
            </StackPanel>
        </controls:PopupWindowHost>

        <controls:ProductImagesPopup DataContext="{Binding ProductImages}" />
    </Grid>
</UserControl>
