<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Production.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Production"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:RecipesViewModel}">
        <Grid x:Name="LayoutGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10, 10, 0, 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Style="{StaticResource MasterListToolbarBorderStyle}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Przepisy" Style="{StaticResource MasterListTitleTextStyle}" Margin="0,0,3,0" />
                    <controls:CreateButton Command="{Binding CreateRecipeCommand}" ToolTip="Dodaj przepis" Style="{StaticResource MasterListToolbarIconButtonStyle}" />
                    <controls:RefreshButton Click="RecipesRefreshButton_Click" Style="{StaticResource MasterListToolbarIconButtonStyle}" />
                    <controls:FilterToggleButton IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MasterListToolbarIconToggleButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Search Header -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10"
                    Visibility="{Binding IsFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SearchIconGeometry}"
                              Style="{StaticResource ToolbarIconStyle}"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                        <TextBox Text="{Binding SearchTerm,
                                                UpdateSourceTrigger=PropertyChanged,
                                                Delay=500,
                                                NotifyOnSourceUpdated=True}"
                                 SourceUpdated="SearchTerm_SourceUpdated"
                                 Width="150"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recipes List -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Recipes}"
                     controls:ListSelectionBehavior.IsEnabled="True"
                     controls:ListSelectionBehavior.SettledSelectedItem="{Binding SelectedRecipe}"
                     controls:ListSelectionBehavior.SelectionSettled="RecipesList_SelectionChanged"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="8,4,5,4" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text=" (" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ProductIdentifier}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text=")" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pagination -->
            <controls:PaginationControl x:Name="RecipesPagination"
                                        Grid.Row="3"
                                        Layout="CompactTwoRows"
                                        PageLoader="{Binding RecipesPageLoader}"
                                        Margin="0,5,0,0"
                                        FontSize="11" />
        </Grid>

        <controls:RatioGridSplitter Grid.Column="1"
                                    Orientation="Vertical" />

        <!-- Right Panel -->
        <Grid Grid.Column="2" Background="{DynamicResource SurfaceAlternativeBrush}">
            <!-- Empty state -->
            <TextBlock Text="Wybierz przepis z listy, aby zobaczyć szczegóły" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14"
                       Visibility="{Binding SelectedRecipe, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}" />

            <!-- Details section -->
            <Grid Visibility="{Binding SelectedRecipe, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Upper space: Basic Information -->
                <Grid Grid.Row="0" Margin="{StaticResource DetailPaneMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="{Binding SelectedRecipe.Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <controls:EditButton Command="{Binding EditRecipeCommand}" Margin="0,0,2,0" />
                            <controls:DeleteButton Command="{Binding DeleteRecipeCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <!-- Product Details -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <StackPanel Orientation="Vertical" Margin="0,0,0,4">
                                <TextBlock Text="Produkt:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="100" TextAlignment="Left"/>
                                <TextBlock Text="{Binding SelectedRecipe.ProductName}" FontWeight="SemiBold"
                                           TextAlignment="Left" TextWrapping="Wrap" MaxWidth="210"/>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,0,4">
                                <TextBlock Text="Identyfikator:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="100" TextAlignment="Left"/>
                                <TextBlock Text="{Binding SelectedRecipe.ProductIdentifier}" FontWeight="SemiBold"
                                           TextAlignment="Left" TextWrapping="Wrap" MaxWidth="210"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Description -->
                        <Grid Grid.Column="1" MinHeight="75" VerticalAlignment="Stretch">
                            <Border Style="{StaticResource ReadOnlyDescriptionBorderStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SelectedRecipe.Description}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <controls:RatioGridSplitter Grid.Column="2"
                                                    Orientation="Vertical"
                                                    Margin="1,0,2,0" />

                        <controls:ProductImagesPanel Grid.Column="3"
                                                     DataContext="{Binding ProductImages}"
                                                     VerticalAlignment="Stretch" />
                    </Grid>
                </Grid>

                <controls:RatioGridSplitter Grid.Row="1" />

                <!-- Bottom Panel: Required Materials -->
                <Grid Grid.Row="2" Margin="{StaticResource DetailPaneMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header for Materials Table -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Potrzebne Materiały" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <controls:CreateButton Command="{Binding AddRecipeMaterialCommand}" Margin="0,0,2,0" ToolTip="Dodaj materiał" />
                        <controls:RefreshButton Click="RecipeMaterialsRefreshButton_Click" Margin="0,0,2,0" />
                        <controls:FilterToggleButton IsChecked="{Binding IsItemsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Click="RecipeMaterialsFilterToggleButton_Click" />
                    </StackPanel>

                    <!-- Materials DataGrid -->
                    <controls:ConfigurableDataGrid x:Name="RecipeMaterialsDataGrid"
                              Grid.Row="1" LayoutKey="Production.RecipeMaterialsGrid"
                              ItemsSource="{Binding RecipeMaterials}" SelectedItem="{Binding SelectedRecipeMaterial}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{DynamicResource SurfaceBrush}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              ColumnVisibilityChanged="RecipeMaterialsDataGrid_ColumnVisibilityChanged"
                              Sorting="MaterialsDataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"
                                                Visibility="Collapsed" CanUserSort="False"
                                                controls:ConfigurableDataGrid.ColumnKey="Id"
                                                ElementStyle="{StaticResource TechnicalIdDataGridCellTextStyle}"
                                                HeaderTemplate="{StaticResource TechnicalIdDataGridHeaderTemplate}"
                                                controls:ConfigurableDataGrid.ColumnTitle="ID" />
                            <DataGridTemplateColumn Width="1.5*" SortMemberPath="MaterialName">
                                <DataGridTemplateColumn.Header>
                                    <controls:TextFilterColumnHeader
                                        x:Name="MaterialNameFilterColumn"
                                        Header="Materiał"
                                        DebounceMilliseconds="500"
                                        IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        FilterChanged="RecipeMaterialsFilter_FilterChanged" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MaterialName}" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="2*" SortMemberPath="Description">
                                <DataGridTemplateColumn.Header>
                                    <controls:TextFilterColumnHeader
                                        x:Name="DescriptionFilterColumn"
                                        Header="Opis"
                                        DebounceMilliseconds="500"
                                        IsFilterVisible="{Binding DataContext.IsItemsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        FilterChanged="RecipeMaterialsFilter_FilterChanged" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto" MinWidth="72"
                                                    controls:ConfigurableDataGrid.ColumnKey="Actions">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Akcje" FontWeight="Bold" Margin="5,0"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <controls:EditButton
                                                Command="{Binding DataContext.EditRecipeMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Edytuj pozycję"
                                                Margin="1,0" />
                                            <controls:DeleteButton
                                                Command="{Binding DataContext.DeleteRecipeMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Usuń pozycję"
                                                Margin="1,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </controls:ConfigurableDataGrid>

                    <!-- Pagination for Materials -->
                    <controls:PaginationControl x:Name="RecipeMaterialsPagination"
                                                Grid.Row="2"
                                                Layout="SingleLine"
                                                PageLoader="{Binding RecipeMaterialsPageLoader}"
                                                InitialPageSize="20"
                                                HorizontalAlignment="Right"
                                                PaginationHorizontalAlignment="Right"
                                                Margin="0,5,0,0" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Add/Edit Material Popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsAddMaterialPopupOpen}" Title="{Binding AddRecipeMaterialViewModel.Title}" StaysOpen="True">
            <controls:RecipeMaterialEditor DataContext="{Binding AddRecipeMaterialViewModel}" />
        </controls:PopupWindowHost>
        <controls:PopupWindowHost IsOpen="{Binding IsEditMaterialPopupOpen}" Title="{Binding EditRecipeMaterialViewModel.Title}" StaysOpen="True">
            <controls:RecipeMaterialEditor DataContext="{Binding EditRecipeMaterialViewModel}" />
        </controls:PopupWindowHost>

        <!-- Create/Edit Recipe Popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsCreatePopupOpen}" Title="{Binding CreateRecipeViewModel.Title}" StaysOpen="True">
            <controls:RecipeEditor DataContext="{Binding CreateRecipeViewModel}" />
        </controls:PopupWindowHost>
        <controls:PopupWindowHost IsOpen="{Binding IsEditPopupOpen}" Title="{Binding EditRecipeViewModel.Title}" StaysOpen="True">
            <controls:RecipeEditor DataContext="{Binding EditRecipeViewModel}" />
        </controls:PopupWindowHost>

        <!-- Delete Material Confirmation Popup -->
        <controls:PopupWindowHost IsOpen="{Binding IsDeleteMaterialConfirmationOpen}" Title="Usuń materiał z przepisu" StaysOpen="True">
                <StackPanel Width="300">
                    <TextBlock Text="Czy na pewno chcesz usunąć ten materiał z przepisu?" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Command="{Binding CancelDeleteMaterialCommand}" Margin="0,0,10,0" Padding="15,5"/>
                        <Button Content="Usuń" Command="{Binding ConfirmDeleteMaterialCommand}" Padding="15,5" Background="{DynamicResource DangerButtonBackgroundBrush}" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
        </controls:PopupWindowHost>

        <!-- Delete Recipe Confirmation -->
        <controls:PopupWindowHost IsOpen="{Binding IsDeleteConfirmationOpen}" Title="Usuń przepis" StaysOpen="True">
                <StackPanel Width="300">
                    <TextBlock Text="Czy na pewno chcesz usunąć ten przepis?" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Command="{Binding CancelDeleteCommand}" Margin="0,0,10,0" Padding="15,5"/>
                        <Button Content="Usuń" Command="{Binding ConfirmDeleteCommand}" Padding="15,5" Background="{DynamicResource DangerButtonBackgroundBrush}" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
        </controls:PopupWindowHost>

        <controls:ProductImagesPopup DataContext="{Binding ProductImages}" />
    </Grid>
</UserControl>
