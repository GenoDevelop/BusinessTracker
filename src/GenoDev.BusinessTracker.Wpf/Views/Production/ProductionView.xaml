<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Production.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenoDev.BusinessTracker.Wpf.Views.Production"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Production"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:ProductionViewModel}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <local:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecipesViewModel}">
            <local:RecipesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductionListViewModel}">
            <local:ProductionListView />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <TabControl TabStripPlacement="Left"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource SideNavigationTabControlStyle}">
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource ProductsNavigationGeometry}"
                                                   Text="Produkty" />
                </TabItem.Header>
                <ContentControl Content="{Binding ProductsViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource RecipesNavigationGeometry}"
                                                   Text="Przepisy" />
                </TabItem.Header>
                <ContentControl Content="{Binding RecipesViewModel}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <controls:SideNavigationHeader Icon="{StaticResource ProductionNavigationGeometry}"
                                                   Text="Produkcja" />
                </TabItem.Header>
                <ContentControl Content="{Binding ProductionListViewModel}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
