<UserControl x:Class="GenoDev.BusinessTracker.Wpf.Views.Notes.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:controls="clr-namespace:GenoDev.BusinessTracker.Wpf.Controls"
             xmlns:vm="clr-namespace:GenoDev.BusinessTracker.Wpf.ViewModels.Notes"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:NotesViewModel}">
    <UserControl.Resources>
        <x:Array x:Key="EditorFontSizes" Type="{x:Type sys:Double}">
            <sys:Double>10</sys:Double>
            <sys:Double>12</sys:Double>
            <sys:Double>14</sys:Double>
            <sys:Double>16</sys:Double>
            <sys:Double>18</sys:Double>
            <sys:Double>24</sys:Double>
            <sys:Double>32</sys:Double>
            <sys:Double>48</sys:Double>
        </x:Array>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource GlassToolbarBorderStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Notatki"
                           Style="{StaticResource PageTitleTextStyle}"
                           Margin="0,0,20,0" />
                <controls:CreateButton Command="{Binding CreateNoteCommand}"
                                       ToolTip="Dodaj notatkę"
                                       Margin="0,0,2,0" />
                <controls:RefreshButton Click="RefreshButton_Click"
                                        Margin="0,0,2,0" />
                <controls:FilterToggleButton
                    IsChecked="{Binding IsFilterVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Click="FilterToggleButton_Click" />
            </StackPanel>
            </Border>

            <controls:ConfigurableDataGrid x:Name="NotesDataGrid"
                                           Grid.Row="1"
                                           LayoutKey="Notes.NotesGrid"
                                           ItemsSource="{Binding Notes}"
                                           SelectedItem="{Binding SelectedNote, Mode=OneWay}"
                                           AutoGenerateColumns="False"
                                           IsReadOnly="True"
                                           ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                           SelectionChanged="NotesDataGrid_SelectionChanged"
                                           ColumnVisibilityChanged="NotesDataGrid_ColumnVisibilityChanged"
                                           Sorting="NotesDataGrid_Sorting">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.Header>
                            <controls:TextFilterColumnHeader
                                x:Name="NameFilterColumn"
                                Header="Nazwa"
                                DebounceMilliseconds="500"
                                IsFilterVisible="{Binding DataContext.IsFilterVisible, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                FilterChanged="NoteFilter_FilterChanged" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="5,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </controls:ConfigurableDataGrid>

            <controls:PaginationControl x:Name="NotesPagination"
                                        Grid.Row="2"
                                        Layout="CompactTwoRows"
                                        PageLoader="{Binding NotesPageLoader}"
                                        InitialPageSize="20"
                                        HorizontalAlignment="Stretch"
                                        PaginationHorizontalAlignment="Center"
                                        Margin="0,8,0,0" />
        </Grid>

        <GridSplitter Grid.Column="1"
                      Style="{StaticResource VerticalPanelGridSplitterStyle}" />

        <Border Grid.Column="2"
                Margin="10,0,0,0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding EditorNoteName, TargetNullValue=Wybierz notatkę}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,10" />

                <WrapPanel Grid.Row="1"
                           IsEnabled="{Binding IsEditorEnabled}"
                           Margin="0,0,0,8">
                    <ToggleButton x:Name="BoldToggleButton"
                                  Content="B"
                                  FontWeight="Bold"
                                  Command="EditingCommands.ToggleBold"
                                  CommandTarget="{Binding ElementName=NoteEditor}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Style="{StaticResource IconToggleButton}"
                                  Click="FormattingToggleButton_Click"
                                  ToolTip="Pogrubienie"
                                  Width="34"
                                  Height="34"
                                  Margin="0,0,4,4" />
                    <ToggleButton x:Name="ItalicToggleButton"
                                  Content="I"
                                  FontStyle="Italic"
                                  Command="EditingCommands.ToggleItalic"
                                  CommandTarget="{Binding ElementName=NoteEditor}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Style="{StaticResource IconToggleButton}"
                                  Click="FormattingToggleButton_Click"
                                  ToolTip="Kursywa"
                                  Width="34"
                                  Height="34"
                                  Margin="0,0,4,4" />
                    <ToggleButton x:Name="UnderlineToggleButton"
                                  Command="EditingCommands.ToggleUnderline"
                                  CommandTarget="{Binding ElementName=NoteEditor}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Style="{StaticResource IconToggleButton}"
                                  Click="FormattingToggleButton_Click"
                                  ToolTip="Podkreślenie"
                                  Width="34"
                                  Height="34"
                                  Margin="0,0,8,4">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>

                    <ComboBox x:Name="FontSizeComboBox"
                              ItemsSource="{StaticResource EditorFontSizes}"
                              SelectedIndex="2"
                              SelectionChanged="FontSizeComboBox_SelectionChanged"
                              ToolTip="Rozmiar tekstu"
                              Width="70"
                              Height="34"
                              Margin="0,0,8,4" />

                    <ComboBox x:Name="TextColorComboBox"
                              SelectedIndex="0"
                              SelectionChanged="TextColorComboBox_SelectionChanged"
                              ToolTip="Kolor tekstu"
                              Width="125"
                              Height="34"
                              Margin="0,0,8,4">
                        <ComboBoxItem Tag="Black">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="Black" Margin="0,0,6,0" />
                                <TextBlock Text="Czarny" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="DimGray">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="DimGray" Margin="0,0,6,0" />
                                <TextBlock Text="Szary" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="Firebrick">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="Firebrick" Margin="0,0,6,0" />
                                <TextBlock Text="Czerwony" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="DodgerBlue">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="DodgerBlue" Margin="0,0,6,0" />
                                <TextBlock Text="Niebieski" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="ForestGreen">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="ForestGreen" Margin="0,0,6,0" />
                                <TextBlock Text="Zielony" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="DarkViolet">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="DarkViolet" Margin="0,0,6,0" />
                                <TextBlock Text="Fioletowy" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="DarkOrange">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="DarkOrange" Margin="0,0,6,0" />
                                <TextBlock Text="Pomarańczowy" />
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>

                    <ToggleButton x:Name="AlignLeftToggleButton"
                                  Command="EditingCommands.AlignLeft"
                                  CommandTarget="{Binding ElementName=NoteEditor}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Style="{StaticResource IconToggleButton}"
                                  Click="FormattingToggleButton_Click"
                                  ToolTip="Wyrównaj do lewej"
                                  Width="34"
                                  Height="34"
                                  Margin="0,0,4,4">
                        <Path Data="{StaticResource AlignLeftIconGeometry}"
                              Style="{StaticResource ToolbarIconStyle}" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignCenterToggleButton"
                                  Command="EditingCommands.AlignCenter"
                                  CommandTarget="{Binding ElementName=NoteEditor}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Style="{StaticResource IconToggleButton}"
                                  Click="FormattingToggleButton_Click"
                                  ToolTip="Wyśrodkuj"
                                  Width="34"
                                  Height="34"
                                  Margin="0,0,4,4">
                        <Path Data="{StaticResource AlignCenterIconGeometry}"
                              Style="{StaticResource ToolbarIconStyle}" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignRightToggleButton"
                                  Command="EditingCommands.AlignRight"
                                  CommandTarget="{Binding ElementName=NoteEditor}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Style="{StaticResource IconToggleButton}"
                                  Click="FormattingToggleButton_Click"
                                  ToolTip="Wyrównaj do prawej"
                                  Width="34"
                                  Height="34"
                                  Margin="0,0,4,4">
                        <Path Data="{StaticResource AlignRightIconGeometry}"
                              Style="{StaticResource ToolbarIconStyle}" />
                    </ToggleButton>
                    <ToggleButton x:Name="BulletsToggleButton"
                                  Command="EditingCommands.ToggleBullets"
                                  CommandTarget="{Binding ElementName=NoteEditor}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Style="{StaticResource IconToggleButton}"
                                  Click="FormattingToggleButton_Click"
                                  ToolTip="Lista punktowana"
                                  Width="34"
                                  Height="34"
                                  Margin="0,0,4,4">
                        <Path Data="{StaticResource BulletsIconGeometry}"
                              Style="{StaticResource ToolbarIconStyle}" />
                    </ToggleButton>
                    <ToggleButton x:Name="SpellCheckToggleButton"
                                  IsChecked="True"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Style="{StaticResource IconToggleButton}"
                                  Click="SpellCheckToggleButton_Click"
                                  ToolTip="Sprawdzanie pisowni"
                                  Width="52"
                                  Height="34"
                                  Padding="5"
                                  Margin="4,0,0,4">
                        <Grid>
                            <TextBlock Text="ABC"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <Path Data="{StaticResource CheckIconGeometry}"
                                  Style="{StaticResource ToolbarIconStyle}"
                                  Width="12"
                                  Height="12"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom" />
                        </Grid>
                    </ToggleButton>
                </WrapPanel>

                <Grid Grid.Row="2">
                    <RichTextBox x:Name="NoteEditor"
                                 IsEnabled="{Binding IsEditorEnabled}"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 SpellCheck.IsEnabled="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionChanged="NoteEditor_SelectionChanged"
                                 TextChanged="NoteEditor_TextChanged"
                                 Padding="10"
                                 FontSize="14" />

                    <TextBlock Text="Wybierz notatkę z listy po lewej stronie."
                               Visibility="{Binding EditorNoteName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <TextBlock Text="{Binding SaveStatus}"
                               Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Button Content="Zapisz"
                            Click="SaveButton_Click"
                            IsEnabled="{Binding IsEditorEnabled}"
                            MinWidth="90"
                            Padding="15,6"
                            Background="{DynamicResource AccentBrush}"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:PopupWindowHost Grid.ColumnSpan="3"
                                 IsOpen="{Binding IsCreatePopupOpen}"
                                 Title="Dodaj notatkę"
                                 StaysOpen="True">
            <StackPanel DataContext="{Binding CreateNoteViewModel}" Width="360">
                <TextBlock Text="Nazwa (wymagane):" Margin="0,0,0,5" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,20" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,10,0"
                            Padding="15,5" />
                    <Button Content="Dodaj"
                            Command="{Binding SaveCommand}"
                            Padding="15,5"
                            Background="{DynamicResource AccentBrush}"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </controls:PopupWindowHost>
    </Grid>
</UserControl>
